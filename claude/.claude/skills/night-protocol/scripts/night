#!/usr/bin/env bash
# night: step snapshots for unattended work, without touching the index, HEAD or branches.
# See ../SKILL.md (protocol) and ../REFERENCE.md (design).
#
#   night init [topic]            start a night in <repo>/.night/<date>[-topic]
#   night snap NN-slug [path...]  snapshot a green step (NN-slug.msg must exist)
#   night snap --redo NN-slug ... replace the LAST step's snapshot
#   night gate [NN-slug] -- cmd   run cmd on a clean checkout of step NN-slug, or of what
#                                 'snap' would record now; output in gate-<label>.log
#   night verify                  replay the patch chain on a scratch index
#   night status                  base, steps, drafts, committed or not
#   night commit [--dry-run]      owner only (needs a TTY): commit every step
#   night clean [--all] [--force] [--dry-run]
#                                 owner only: delete the night once it is committed
#
# NIGHT_DIR overrides the active night directory (default .night/current).
set -euo pipefail

die() { printf 'night: %s\n' "$*" >&2; exit 1; }
say() { printf 'night: %s\n' "$*"; }

top=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repository"
cd "$top"

night_dir() {
   local d=${NIGHT_DIR:-.night/current}
   [[ -f $d/base ]] || die "no active night ($d): run 'night init' first"
   printf '%s\n' "$d"
}

base_commit() { cat "$1/base"; }

# git diff for patches and file lists, immune to the owner's diff config (noprefix, external
# diff, textconv): the patch must replay byte for byte.
gdiff() {
   git -c diff.noprefix=false -c diff.mnemonicPrefix=false diff --no-color --no-ext-diff --no-textconv "$@"
}

# Blob id of a working-tree path, '-' when it does not exist.
path_hash() {
   if [[ -e $1 || -L $1 ]]; then git hash-object -- "$1" 2>/dev/null || echo '?'; else echo -; fi
}
base_tree() { git rev-parse "$(base_commit "$1")^{tree}"; }

# True when the night has no step, or its last step tree is the tree of a commit in base..HEAD
# (an exact tree match, so a squash of the whole chain counts and an amended last step does not).
night_committed() {
   local dir=$1 last base
   [[ -s $dir/chain ]] || return 0
   last=$(tail -n 1 "$dir/chain" | cut -d' ' -f3)
   base=$(base_commit "$dir")
   git merge-base --is-ancestor "$base" HEAD 2>/dev/null || return 1
   git log --format=%T "$base..HEAD" | grep -qxF "$last"
}

last_tree() {
   local dir=$1
   if [[ -s $dir/chain ]]; then
      tail -n 1 "$dir/chain" | cut -d' ' -f3
   else
      base_tree "$dir"
   fi
}

# Tree = tree $2 plus the working-tree changes (all of them, or only the paths given), built through
# a scratch index. Without paths, the changes that predate the night ($1/preexisting) and are still
# byte-identical to what 'init' saw are left out; one edited since is included, with a note.
build_tree() {
   local dir=$1 prev=$2 idx tree h p
   shift 2
   local -a spec=("$@")
   if ((!${#spec[@]})); then
      spec=(.)
      if [[ -s $dir/preexisting ]]; then
         while IFS=$'\t' read -r h p; do
            if [[ $(path_hash "$p") == "$h" ]]; then
               spec+=(":(exclude,literal)$p")
            else
               say "NOTE $p predates the night but was edited since: included" >&2
            fi
         done < "$dir/preexisting"
      fi
   fi
   idx=$(mktemp)
   GIT_INDEX_FILE=$idx git read-tree "$prev"
   GIT_INDEX_FILE=$idx git add -A -- "${spec[@]}"
   tree=$(GIT_INDEX_FILE=$idx git write-tree)
   rm -f "$idx"
   printf '%s\n' "$tree"
}

# Tree object of the working tree, built on top of tree $1 through a scratch index.
worktree_tree() {
   local idx tree
   idx=$(mktemp)
   GIT_INDEX_FILE=$idx git read-tree "$1"
   GIT_INDEX_FILE=$idx git add -A
   tree=$(GIT_INDEX_FILE=$idx git write-tree)
   rm -f "$idx"
   printf '%s\n' "$tree"
}

cmd_init() {
   local name dir exclude p
   git diff --cached --quiet ||
      die "the index has staged changes: commit or unstage them first ('night commit' would refuse)"
   name=$(date +%F)${1:+-$1}
   dir=.night/$name
   [[ -e $dir ]] && die "$dir already exists"
   mkdir -p "$dir"
   git rev-parse HEAD > "$dir/base"
   : > "$dir/chain"
   ln -sfn "$name" .night/current
   exclude=$(git rev-parse --git-path info/exclude)
   mkdir -p "$(dirname "$exclude")"
   grep -qxF '/.night/' "$exclude" 2>/dev/null || echo '/.night/' >> "$exclude"
   cat > "$dir/LOG.md" <<EOF
# Night log $name

Base: \`$(git log -1 --format='%h %s')\` (tree \`$(base_tree "$dir" | cut -c1-12)\`).
Protocol: night-protocol skill. Nothing is staged or committed; each green step is a tree snapshot.
Morning: \`night status\`, read this log, then \`night commit\` from your own terminal.

## Plan

## Decisions taken on the owner's behalf

## Decisions left to the owner

## Chronology
EOF
   # Changes already in the working tree belong to the owner, not to the night: record them
   # so that 'snap' without paths leaves them out.
   { git diff --name-only -z HEAD --; git ls-files -z --others --exclude-standard; } |
      while IFS= read -r -d '' p; do
         printf '%s\t%s\n' "$(path_hash "$p")" "$p"
      done > "$dir/preexisting"
   say "night started in $dir (base $(git rev-parse --short HEAD))"
   if [[ -s $dir/preexisting ]]; then
      say "NOTE these changes predate the night; 'snap' without paths leaves them out while unedited:"
      cut -f2 "$dir/preexisting" | sed 's/^/   /'
   fi
}

cmd_snap() {
   local redo=0 dir step prev idx tree n
   [[ ${1:-} == --redo ]] && { redo=1; shift; }
   step=${1:?usage: night snap [--redo] NN-slug [path...]}
   shift
   [[ $step =~ ^[0-9]{2}-[a-z0-9._-]+$ ]] || die "step name must look like 03-seam-fill"
   dir=$(night_dir)
   [[ -s $dir/$step.msg ]] || die "write the commit message to $dir/$step.msg first"
   if ((redo)); then
      [[ $(tail -n 1 "$dir/chain" | cut -d' ' -f1) == "$step" ]] || die "--redo works only on the last step"
      prev=$(tail -n 1 "$dir/chain" | cut -d' ' -f2)
   else
      [[ -e $dir/$step.tree ]] && die "$step is already snapshot (use --redo if it is the last step)"
      prev=$(last_tree "$dir")
   fi
   tree=$(build_tree "$dir" "$prev" "$@")
   [[ $tree == "$prev" ]] && die "nothing changed since the previous step"
   gdiff --binary "$prev" "$tree" > "$dir/$step.patch"
   gdiff --name-status "$prev" "$tree" > "$dir/$step.files"
   echo "$tree" > "$dir/$step.tree"
   # The chain line goes last, so a failure above leaves the chain as it was.
   ((redo)) && sed -i '$d' "$dir/chain"
   echo "$step $prev $tree" >> "$dir/chain"
   n=$(wc -l < "$dir/$step.files")
   say "$step: tree ${tree:0:12}, $n file(s) — check the list for build junk:"
   sed 's/^/   /' "$dir/$step.files"
   mixing_warnings "$dir"
}

# A night and day-time git work must not overlap: warn as soon as they do, not at 'night commit'.
mixing_warnings() {
   local dir=$1 head_tree
   git diff --cached --quiet ||
      say "WARNING the real index has staged changes: 'night commit' will refuse until they are unstaged"
   head_tree=$(git rev-parse 'HEAD^{tree}')
   if [[ $head_tree != "$(base_tree "$dir")" ]] && ! cut -d' ' -f3 "$dir/chain" | grep -qxF "$head_tree"; then
      say "WARNING HEAD moved off this night: 'night commit' will refuse; the owner commits or drops this night before new day-time commits"
   fi
}

cmd_gate() {
   local dir label tree wt log rc
   dir=$(night_dir)
   if [[ ${1:-} != -- ]]; then
      label=${1:-}
      [[ -n $label ]] || die "usage: night gate [NN-slug] -- command [args...]"
      shift
      [[ -f $dir/$label.tree ]] || die "no snapshot $label in $dir"
      tree=$(<"$dir/$label.tree")
   else
      label=candidate
      tree=$(build_tree "$dir" "$(last_tree "$dir")")
   fi
   [[ ${1:-} == -- ]] || die "usage: night gate [NN-slug] -- command [args...]"
   shift
   (($#)) || die "usage: night gate [NN-slug] -- command [args...]"
   wt=$(readlink -f "$dir")/wt-$label
   log=$dir/gate-$label.log
   git worktree remove --force "$wt" 2>/dev/null || rm -rf "$wt"
   git worktree prune
   git worktree add -q --detach "$wt" "$(base_commit "$dir")"
   # shellcheck disable=SC2064 # expand now: $wt and $top are fixed for this run
   trap "git -C '$top' worktree remove --force '$wt' 2>/dev/null; git -C '$top' worktree prune" EXIT
   git -C "$wt" read-tree -u --reset "$tree"
   say "gate $label: tree ${tree:0:12} checked out in $wt"
   set +e
   (cd "$wt" && NIGHT_REPO=$top NIGHT_TREE=$tree "$@") 2>&1 | tee "$log"
   rc=${PIPESTATUS[0]}
   set -e
   say "gate $label: exit $rc (log $log)"
   return "$rc"
}

cmd_verify() {
   local dir idx step prev tree got expect wt rc=0
   dir=$(night_dir)
   [[ -s $dir/chain ]] || die "no step snapshot yet"
   idx=$(mktemp)
   expect=$(base_tree "$dir")
   GIT_INDEX_FILE=$idx git read-tree "$expect"
   while read -r step prev tree; do
      [[ $prev == "$expect" ]] || { say "FAIL $step: chain broken (prev $prev != $expect)"; rc=1; break; }
      # --whitespace=nowarn: an owner's apply.whitespace=fix would otherwise rewrite the patch.
      if ! GIT_INDEX_FILE=$idx git apply --cached --whitespace=nowarn "$dir/$step.patch"; then
         say "FAIL $step: patch does not apply"; rc=1; break
      fi
      got=$(GIT_INDEX_FILE=$idx git write-tree)
      [[ $got == "$tree" ]] || { say "FAIL $step: patch gives $got, snapshot is $tree"; rc=1; break; }
      say "ok   $step"
      expect=$tree
   done < "$dir/chain"
   rm -f "$idx"
   ((rc)) && return 1
   wt=$(worktree_tree "$expect")
   if [[ $wt == "$expect" ]]; then
      say "ok   working tree == last step"
   else
      say "NOTE working tree has changes outside every step:"
      gdiff --stat "$expect" "$wt" | sed 's/^/   /'
   fi
   [[ $(git rev-parse 'HEAD^{tree}') == "$(base_tree "$dir")" ]] ||
      say "NOTE HEAD moved since the base; 'night commit' needs HEAD back on the base tree"
}

cmd_status() {
   local dir step prev tree subj n
   dir=$(night_dir)
   echo "night: $(readlink -f "$dir")"
   echo "base:  $(git log -1 --format='%h %s' "$(base_commit "$dir")")"
   echo "HEAD:  $(git log -1 --format='%h %s')"
   while read -r step prev tree; do
      subj=$(head -n 1 "$dir/$step.msg")
      n=$(wc -l < "$dir/$step.files")
      printf '  %-28s %3d file(s)  %s\n' "$step" "$n" "$subj"
   done < "$dir/chain"
   shopt -s nullglob
   local -a drafts=("$dir"/*.comment.md) posted=("$dir"/*.comment.posted.md)
   printf 'drafts: %d to post%s, %d posted\n' "${#drafts[@]}" \
      "$( ((${#drafts[@]})) && printf ' (%s)' "${drafts[*]##*/}")" "${#posted[@]}"
   if night_committed "$dir"; then
      echo "committed: yes ('night clean' removes this night once no draft is left to post)"
   else
      echo "committed: no"
   fi
}

cmd_commit() {
   local dry=0 dir head_tree start=0 i=0 step prev tree
   [[ ${1:-} == --dry-run ]] && dry=1
   if ((!dry)) && ! [[ -t 0 && -t 1 ]]; then
      die "commit runs only from the owner's terminal (agents never commit; use --dry-run)"
   fi
   dir=$(night_dir)
   cmd_verify || die "the chain does not verify; nothing committed"
   git diff --cached --quiet || die "the index has staged changes; unstage them first"
   head_tree=$(git rev-parse 'HEAD^{tree}')
   # Resume after a partial run: start after the step whose tree HEAD already holds.
   if [[ $head_tree != "$(base_tree "$dir")" ]]; then
      while read -r step prev tree; do
         i=$((i + 1))
         [[ $tree == "$head_tree" ]] && start=$i
      done < "$dir/chain"
      ((start)) || die "HEAD is neither the base nor a step: the steps would revert later commits"
      say "resuming after step $start"
   fi
   i=0
   while read -r step prev tree; do
      i=$((i + 1))
      ((i <= start)) && continue
      if ((dry)); then
         echo "git read-tree $tree && git commit -F $dir/$step.msg"
      else
         say "committing $step"
         git read-tree "$tree"
         git commit -F "$dir/$step.msg" < /dev/tty
      fi
   done < "$dir/chain"
   ((dry)) || say "done; the working tree was never touched — 'git status' shows anything outside the steps"
   ((dry)) || say "post the drafts (each renamed *.comment.posted.md), then 'night clean' removes the night"
}

# Delete night directories. Never touches the working tree, the index or any ref: the steps live
# on in the commits, only the snapshots, patches, LOG.md and drafts go.
cmd_clean() {
   local all=0 force=0 dry=0 rc=0 d cur exclude
   local -a dirs=() why=() drafts=()
   while (($#)); do
      case $1 in
         --all) all=1 ;;
         --force) force=1 ;;
         --dry-run) dry=1 ;;
         *) die "usage: night clean [--all] [--force] [--dry-run]" ;;
      esac
      shift
   done
   if ((!dry)) && ! [[ -t 0 && -t 1 ]]; then
      die "clean runs only from the owner's terminal (agents never delete a night; use --dry-run)"
   fi
   [[ -d .night ]] || { say "no .night directory here"; return 0; }
   shopt -s nullglob
   cur=$(readlink .night/current 2>/dev/null || true)
   if ((all)); then
      for d in .night/*/; do
         d=${d%/}
         [[ -L $d ]] || dirs+=("$d")
      done
   else
      [[ -n $cur && -d .night/$cur ]] || die "no active night (.night/current); use --all"
      dirs=(".night/$cur")
   fi
   for d in "${dirs[@]}"; do
      why=()
      if [[ ! -f $d/base ]]; then
         why+=("no base file, not a night directory")
      elif ! night_committed "$d"; then
         why+=("last step is not committed on HEAD")
      fi
      drafts=("$d"/*.comment.md)
      ((${#drafts[@]})) && why+=("${#drafts[@]} draft(s) not posted: ${drafts[*]##*/}")
      if ((${#why[@]})) && ((!force)); then
         say "keep   $d: $(printf '%s; ' "${why[@]}" | sed 's/; $//') (--force removes it)"
         rc=1
         continue
      fi
      ((${#why[@]})) && say "FORCED $d: $(printf '%s; ' "${why[@]}" | sed 's/; $//')"
      if ((dry)); then
         say "would remove $d"
         continue
      fi
      rm -rf -- "$d"
      say "removed $d"
      [[ $d == ".night/$cur" ]] && rm -f .night/current
   done
   ((dry)) && return "$rc"
   if rmdir .night 2>/dev/null; then
      exclude=$(git rev-parse --git-path info/exclude)
      [[ -f $exclude ]] && sed -i '\#^/\.night/$#d' "$exclude"
      say "removed .night/ and its line in $exclude"
   fi
   return "$rc"
}

case ${1:-} in
   init) shift; cmd_init "$@" ;;
   snap) shift; cmd_snap "$@" ;;
   gate) shift; cmd_gate "$@" ;;
   verify) cmd_verify ;;
   status) cmd_status ;;
   commit) shift; cmd_commit "$@" ;;
   clean) shift; cmd_clean "$@" ;;
   *) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 2 ;;
esac
