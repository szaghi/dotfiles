#!/usr/bin/env python3
"""delegate: run one self-contained task on a pi or opencode executor in a throwaway git clone.

The orchestrator (Claude Code / Opus) hands a task to an executor harness (pi by default,
opencode with --harness opencode) running a local or cloud model.
The executor works in a private `git clone --shared` (no remote) checked out at a snapshot of the
current working tree: uncommitted and untracked files included, ignored ones not. The
caller's index, refs, stash, worktrees and checkout are never touched. The result is one
JSON object on stdout; the evidence is the patch and the check command (run on a clean
checkout of the patch tree), never the executor's own report. See ../SKILL.md.

  delegate [options] TASK         TASK as an argument, '-' for stdin, or --task-file FILE

Exit status: 0 status ok; 1 check_failed, timeout, error (after the executor started) or
backend_down; 2 setup error before the executor started (not a git repository, harness missing,
bad --base/--link/--out, bad arguments); 128+N interrupted by signal N.
"""

from __future__ import annotations

import argparse
import contextlib
import ctypes
import json
import os
import secrets
import shutil
import signal
import subprocess
import sys
import time
import traceback
import urllib.error
import urllib.request
from collections import Counter
from pathlib import Path
from typing import Any

DEFAULT_MODEL = "ollama/qwen3.8-unsloth:27b-ud-q4_K_XL"
DEFAULT_TIMEOUT = 900
DEFAULT_KEEP_ALIVE = "30m"
FINAL_MESSAGE_CAP = 4000
TAIL_LINES = 40
PR_SET_CHILD_SUBREAPER = 36
DEFAULT_SERVER_WAIT = 300

# pi provider name -> (llm-local-server backend, default port) for llama-server engines.
LLAMA_PROVIDERS = {"llamacpp": ("llama", 8080), "ikllama": ("ikllama", 8081)}

PREAMBLE = """\
You are an executor working for an orchestrator that reviews your diff and reruns its own checks.
Work only inside the current directory. Never run git commit, git push, git reset, git stash or
git config. Change only what the task asks for. If the task is ambiguous or cannot be done, stop
and say so instead of guessing. End with a short report: files changed, commands run with their
results, and anything left undone."""

PI_FLAGS = ["--offline", "-p", "--mode", "json", "-nc", "-ns", "-ne", "-np", "--no-session"]

# opencode: a private server per run (not the background service), JSON events, permissions
# auto-approved (a headless run cannot answer a prompt). The environment keeps it from loading
# ~/.claude instructions and skills (pi's -nc/-ns), from updating itself mid-run and from
# copying the clone into its own snapshot store; web tools are denied as pi has none.
# The prompt goes on stdin with no message argument: opencode 2.1 sends argv text after `--`
# twice and re-quotes every argument containing a space (`"` -> `\"`); stdin it passes raw.
OPENCODE_FLAGS = ["run", "--standalone", "--format", "json", "--auto"]
OPENCODE_ENV = {
    "OPENCODE_DISABLE_CLAUDE_CODE": "1",
    "OPENCODE_DISABLE_AUTOUPDATE": "1",
    "OPENCODE_CONFIG_CONTENT": json.dumps(
        {"snapshot": False, "permission": {"webfetch": "deny", "websearch": "deny"}}
    ),
}
HARNESSES = ("pi", "opencode")

# Named fallback chains, decided in advance: ordered "harness:provider/model" entries. delegate moves to
# the next entry only when an attempt failed before doing any work (falls_back), never after a failed
# check or a timeout. $DELEGATE_CHAIN_<NAME> (comma-separated entries) overrides or adds a chain.
#   public:  free OpenCode Zen DeepSeek (shared free quota, no published data policy), then the paid
#            OpenCode Go DeepSeek (zero retention, no training), then the local default.
#   private: the local default only; the code never leaves the machine.
CHAINS = {
    "public": (
        "opencode:opencode/deepseek-v4.1-flash-free",
        "pi:opencode-go/deepseek-v4.1-flash",
        f"pi:{DEFAULT_MODEL}",
    ),
    "private": (f"pi:{DEFAULT_MODEL}",),
}

# Patch generation: plumbing, so no user/repo diff config (noprefix, color, textconv, external
# drivers) can change the bytes; full index lines and binary hunks so `git apply` can use it.
DIFF_FLAGS = [
    "-p", "--binary", "--full-index", "--no-color", "--no-ext-diff", "--no-textconv",
    "--no-renames", "--src-prefix=a/", "--dst-prefix=b/",
]  # fmt: skip

# Inherited git variables would redirect every command below to the wrong repository/index.
GIT_ENV_DROP = (
    "GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY", "GIT_COMMON_DIR",
    "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_PREFIX", "GIT_NAMESPACE",
)  # fmt: skip

IDENT = {
    "GIT_AUTHOR_NAME": "delegate",
    "GIT_AUTHOR_EMAIL": "delegate@localhost",
    "GIT_COMMITTER_NAME": "delegate",
    "GIT_COMMITTER_EMAIL": "delegate@localhost",
}


class SetupError(Exception):
    """A problem found before the executor started: status 'error', exit 2."""


class DelegateError(Exception):
    """A problem after the executor started: status 'error', exit 1."""


class BackendDownError(Exception):
    """The model backend is unreachable or failed to load the model."""


class Interrupted(BaseException):
    """Raised by the signal handler so that cleanup and the JSON report still happen."""

    def __init__(self, signum: int) -> None:
        super().__init__(signum)
        self.signum = signum


def _on_signal(signum: int, _frame: object) -> None:
    raise Interrupted(signum)


# --------------------------------------------------------------------------- processes


def become_subreaper() -> None:
    """Adopt orphaned descendants (pi detaches its bash tool's children) so they can be reaped."""
    with contextlib.suppress(OSError, AttributeError):
        ctypes.CDLL(None, use_errno=True).prctl(PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0)


def descendants() -> list[int]:
    """PIDs of every live descendant of this process (Linux /proc)."""
    children: dict[int, list[int]] = {}
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            stat = (entry / "stat").read_text()
        except OSError:
            continue
        ppid = int(stat.rsplit(")", 1)[1].split()[1])
        children.setdefault(ppid, []).append(int(entry.name))
    found: list[int] = []
    stack = [os.getpid()]
    while stack:
        for child in children.get(stack.pop(), []):
            found.append(child)
            stack.append(child)
    return found


def reap_descendants(grace: float = 3.0) -> int:
    """SIGTERM, then SIGKILL, every descendant; collect zombies. Return how many were found."""
    victims = descendants()
    for sig in (signal.SIGTERM, signal.SIGKILL):
        for pid in victims:
            with contextlib.suppress(ProcessLookupError, PermissionError):
                os.kill(pid, sig)
        deadline = time.monotonic() + grace
        while time.monotonic() < deadline:
            with contextlib.suppress(ChildProcessError):
                while os.waitpid(-1, os.WNOHANG)[0] > 0:
                    pass
            if not descendants():
                return len(victims)
            time.sleep(0.1)
        victims = descendants()
    return len(victims)


def run_bounded(  # noqa: PLR0913
    cmd: list[str],
    cwd: Path,
    env: dict[str, str],
    out: Path,
    err: Path,
    timeout: float,
    stdin: Path | None = None,
) -> tuple[int | None, float]:
    """Run cmd; return (exit code or None on timeout, seconds). Descendants never survive it.

    stdin is /dev/null unless a file is given (an open stdin makes `pi -p` block forever).
    """
    t0 = time.monotonic()
    with out.open("wb") as fo, contextlib.ExitStack() as stack:
        # out == err: one handle, stderr merged (two "wb" handles would overwrite each other).
        fe = subprocess.STDOUT if err == out else stack.enter_context(err.open("wb"))
        fi = stack.enter_context(stdin.open("rb")) if stdin else subprocess.DEVNULL
        proc = subprocess.Popen(
            cmd,
            cwd=cwd,
            env=env,
            stdin=fi,
            stdout=fo,
            stderr=fe,
            start_new_session=True,
        )
        code: int | None = None
        try:
            code = proc.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            code = None
        finally:
            with contextlib.suppress(ProcessLookupError, PermissionError):
                os.killpg(proc.pid, signal.SIGTERM)
            reap_descendants()
            with contextlib.suppress(subprocess.TimeoutExpired):
                proc.wait(timeout=5)
    return code, time.monotonic() - t0


# --------------------------------------------------------------------------- git helpers


def base_env() -> dict[str, str]:
    """os.environ without inherited git redirections."""
    return {k: v for k, v in os.environ.items() if k not in GIT_ENV_DROP}


def git_raw(*args: str, cwd: Path, env: dict[str, str] | None = None, check: bool = True) -> bytes:
    """Run git without hooks; return raw stdout (exact bytes, nothing stripped)."""
    cmd = ["git", "-c", "core.hooksPath=/dev/null", *args]
    proc = subprocess.run(
        cmd, cwd=cwd, env={**base_env(), **(env or {})}, capture_output=True, check=False
    )
    if check and proc.returncode != 0:
        msg = proc.stderr.decode(errors="replace").strip()
        raise DelegateError(f"git {' '.join(args)}: {msg}")
    return proc.stdout


def git(*args: str, cwd: Path, env: dict[str, str] | None = None, check: bool = True) -> str:
    """Run git; return stdout decoded and stripped (for SHAs and short messages only)."""
    return git_raw(*args, cwd=cwd, env=env, check=check).decode(errors="replace").strip()


def snapshot_tree(workdir: Path, base: str | None, exclude: list[str], scratch: Path) -> str:
    """Tree of workdir's files, ignored ones and `exclude` left out, via a private index."""
    index = scratch / f"index-{secrets.token_hex(4)}"
    env = {"GIT_INDEX_FILE": str(index)}
    if base:
        git("read-tree", base, cwd=workdir, env=env)
    pathspec = ["--", ".", *[f":(exclude,top){p}" for p in exclude]]
    git("add", "-A", *pathspec, cwd=workdir, env=env)
    tree = git("write-tree", cwd=workdir, env=env)
    index.unlink(missing_ok=True)
    return tree


def commit_tree(tree: str, parent: str | None, cwd: Path) -> str:
    """A dangling, unsigned commit for tree (never on any ref)."""
    parents = ["-p", parent] if parent else []
    return git("commit-tree", "--no-gpg-sign", tree, *parents, "-m", "delegate", cwd=cwd, env=IDENT)


def base_commit_for(repo: Path, base: str, scratch: Path) -> tuple[str, str]:
    """Return (commit, description) for the executor's starting point."""
    head = git("rev-parse", "--verify", "--quiet", "HEAD", cwd=repo, check=False) or None
    if base != "worktree":
        try:
            commit = git("rev-parse", "--verify", f"{base}^{{commit}}", cwd=repo)
        except DelegateError as err:
            raise SetupError(f"--base {base}: not a revision") from err
        return commit, base
    tree = snapshot_tree(repo, head, [], scratch)
    return commit_tree(tree, head, repo), "working tree" + (f" on {head[:12]}" if head else "")


def make_clone(repo: Path, workdir: Path, commit: str) -> None:
    """Private clone sharing the caller's objects read-only; no remote, detached at commit."""
    git("clone", "--shared", "--no-checkout", "--quiet", str(repo), str(workdir), cwd=repo)
    git("remote", "remove", "origin", cwd=workdir)
    exclude = Path(
        git("rev-parse", "--path-format=absolute", "--git-path", "info/exclude", cwd=repo)
    )
    if exclude.is_file():
        shutil.copyfile(exclude, workdir / ".git" / "info" / "exclude")
    git("checkout", "--quiet", "--detach", commit, cwd=workdir)


def place_links(repo: Path, workdir: Path, links: list[str]) -> None:
    """Symlink each (validated, repo-relative) path of the caller's repo into workdir."""
    for rel in links:
        dst = workdir / rel
        if dst.exists() or dst.is_symlink():
            raise DelegateError(f"--link {rel}: already present in the clone (is it tracked?)")
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.symlink_to(repo / rel)


def normalise_link(rel: str, repo: Path) -> str:
    """Validate a --link path: repo-relative, inside the repo, existing."""
    norm = os.path.normpath(rel.strip())
    if os.path.isabs(norm) or norm == "." or norm.split(os.sep)[0] == "..":
        raise SetupError(f"--link {rel}: must be a path inside the repository")
    if not (repo / norm).exists():
        raise SetupError(f"--link {rel}: {repo / norm} does not exist")
    return norm


# --------------------------------------------------------------------------- backend


def pi_provider(provider: str) -> dict[str, Any]:
    """The provider's entry in ~/.pi/agent/models.json ({} when absent or unreadable)."""
    models = Path.home() / ".pi" / "agent" / "models.json"
    with contextlib.suppress(OSError, ValueError, KeyError, TypeError, AttributeError):
        entry = json.loads(models.read_text())["providers"][provider]
        if isinstance(entry, dict):
            return entry
    return {}


def server_root(provider: str, default: str) -> str:
    """Server root URL of a provider: models.json baseUrl without the /v1 suffix."""
    url = pi_provider(provider).get("baseUrl") or default
    return str(url).rstrip("/").removesuffix("/v1")


def ollama_url(provider: str) -> str | None:
    """Base URL of an Ollama provider, or None when the provider is not Ollama."""
    if provider != "ollama":
        return None
    if url := os.environ.get("DELEGATE_OLLAMA_URL"):
        return url.rstrip("/").removesuffix("/v1")
    return server_root("ollama", "http://localhost:11434")


def http_get(url: str, timeout: float) -> tuple[int | None, bytes]:
    """GET url; return (HTTP status, body), status None when no connection could be made."""
    try:
        with urllib.request.urlopen(url, timeout=timeout) as resp:
            return resp.status, resp.read()
    except urllib.error.HTTPError as err:
        return err.code, b""
    except (urllib.error.URLError, TimeoutError, OSError, ValueError):
        return None, b""


def llama_preflight(provider: str, model_id: str, wait: float) -> tuple[dict[str, Any], list[str]]:
    """Check a llama-server provider; return (server facts, warnings).

    /health: no connection fails at once (the server is not running, waiting cannot help);
    503 means the model is still loading, so poll up to `wait` seconds. /props, when the
    engine has it (ik_llama may not), names the GGUF and the per-slot context.
    """
    backend, port = LLAMA_PROVIDERS[provider]
    base = server_root(provider, f"http://127.0.0.1:{port}")
    hint = f"llm-local-server start --backend {backend} --model <gguf> --ctx 32k"
    deadline = time.monotonic() + wait
    while True:
        status, _ = http_get(f"{base}/health", timeout=3)
        if status == 200:  # noqa: PLR2004
            break
        if status is None:
            raise BackendDownError(f"{provider}: no server at {base}; start it: {hint}")
        if status != 503 or time.monotonic() > deadline:  # noqa: PLR2004
            raise BackendDownError(f"{provider}: {base}/health answered HTTP {status}")
        time.sleep(1)
    server: dict[str, Any] = {"engine": provider, "url": base, "model": None, "n_ctx": None}
    status, body = http_get(f"{base}/props", timeout=5)
    props: Any = None
    if status == 200:  # noqa: PLR2004
        with contextlib.suppress(ValueError):
            props = json.loads(body)
    if isinstance(props, dict):
        if path := props.get("model_path"):
            server["model"] = Path(str(path)).name
        gen = props.get("default_generation_settings")
        n_ctx = gen.get("n_ctx") if isinstance(gen, dict) else props.get("n_ctx")
        if isinstance(n_ctx, int):
            server["n_ctx"] = n_ctx
    warnings = []
    window = next(
        (m.get("contextWindow") for m in _dicts(pi_provider(provider).get("models"))
         if m.get("id") == model_id),
        None,
    )  # fmt: skip
    if isinstance(window, int) and server["n_ctx"] and window > server["n_ctx"]:
        warnings.append(
            f"models.json contextWindow {window} > server n_ctx {server['n_ctx']}: pi will plan "
            f"for context the server rejects; restart the server with --ctx {window} or lower "
            "contextWindow"
        )
    return server, warnings


def ollama_post(url: str, payload: dict[str, Any], timeout: float) -> None:
    """POST a JSON payload to an Ollama endpoint, raising BackendDownError on failure."""
    req = urllib.request.Request(
        url, data=json.dumps(payload).encode(), headers={"Content-Type": "application/json"}
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            resp.read()
    except (urllib.error.URLError, TimeoutError, OSError, ValueError) as err:
        raise BackendDownError(f"{url}: {err}") from err


def ollama_warm(base: str, model_id: str, keep_alive: str) -> float:
    """Check the server, load the model, keep it resident; return seconds spent."""
    t0 = time.monotonic()
    try:
        with urllib.request.urlopen(f"{base}/api/version", timeout=3) as resp:
            resp.read()
    except (urllib.error.URLError, TimeoutError, OSError, ValueError) as err:
        raise BackendDownError(
            f"Ollama not reachable at {base} ({err}); start it: llm-local-server start"
        ) from err
    ollama_post(f"{base}/api/generate", {"model": model_id, "keep_alive": keep_alive}, timeout=600)
    return time.monotonic() - t0


# --------------------------------------------------------------------------- reporting


def _dicts(value: object) -> list[dict[str, Any]]:
    return [v for v in value if isinstance(v, dict)] if isinstance(value, list) else []


def _cap(final: str, path: Path) -> str:
    if len(final) > FINAL_MESSAGE_CAP:
        return final[:FINAL_MESSAGE_CAP] + f"\n[... truncated; full text in {path}]"
    return final


def _events(path: Path) -> list[dict[str, Any]]:
    """The JSON objects of a JSONL file, malformed or non-object lines skipped."""
    out = []
    for line in path.read_text(errors="replace").splitlines():
        with contextlib.suppress(ValueError):
            ev = json.loads(line)
            if isinstance(ev, dict):
                out.append(ev)
    return out


def parse_opencode_events(path: Path) -> dict[str, Any]:
    """Summarise `opencode run --format json` events, in the same shape as parse_pi_events.

    opencode emits step_start / tool_use / text / step_finish parts and an `error` event on a
    provider or session failure; it has no end-of-run event, so `finished` means "no error
    event and at least one step" and the caller also requires exit status 0. Once the session
    goes idle `opencode run` drops everything but the final text, so the last step's
    step_finish never arrives: `usage` is a lower bound and `stop_reason` is None unless an
    error event names one (a step_finish reason would be the second-to-last step's).
    """
    tools: Counter[str] = Counter()
    tool_errors = steps = 0
    usage: dict[str, Any] = {"input": 0, "output": 0, "cache_read": 0, "cost_usd": 0.0}
    texts: dict[str, list[str]] = {}
    last_msg = None
    stop = error = error_type = None  # stop stays None unless an error event sets it (docstring)
    for ev in _events(path):
        kind = ev.get("type")
        part = ev.get("part") if isinstance(ev.get("part"), dict) else {}
        if kind == "step_start":
            steps += 1
        elif kind == "tool_use":
            tools[str(part.get("tool", "?"))] += 1
            state = part.get("state")
            if isinstance(state, dict) and state.get("status") == "error":
                tool_errors += 1
        elif kind == "text" and isinstance(part.get("text"), str):
            last_msg = str(part.get("messageID"))
            texts.setdefault(last_msg, []).append(part["text"])
        elif kind == "step_finish":
            tok = part.get("tokens")
            with contextlib.suppress(TypeError, ValueError, AttributeError):
                usage["input"] += int(tok.get("input") or 0)
                usage["output"] += int(tok.get("output") or 0)
                usage["cache_read"] += int((tok.get("cache") or {}).get("read") or 0)
            with contextlib.suppress(TypeError, ValueError):
                usage["cost_usd"] += float(part.get("cost") or 0)
        elif kind == "error":
            err = ev.get("error")
            error = err.get("message") or err.get("type") if isinstance(err, dict) else str(err)
            error_type = err.get("type") if isinstance(err, dict) else None
            stop = "error"
    final = "\n".join(texts.get(last_msg, [])).strip() if last_msg else ""
    summary = {
        "finished": steps > 0 and error is None,
        "stop_reason": stop,
        "turns": steps,
        "tools": dict(tools),
        "tool_errors": tool_errors,
        "usage": usage | {"cost_usd": round(usage["cost_usd"], 6)},
        "final_message": _cap(final, path),
    }
    if error:
        summary["provider_error"] = str(error)
        summary["provider_error_type"] = error_type
    return summary


def parse_pi_events(path: Path) -> dict[str, Any]:
    """Summarise pi's JSON event stream; tolerant of malformed or unexpected lines."""
    tools: Counter[str] = Counter()
    tool_errors = 0
    messages: list[dict[str, Any]] = []
    finished = False
    for ev in _events(path):
        kind = ev.get("type")
        if kind == "tool_execution_start":
            tools[str(ev.get("toolName", "?"))] += 1
        elif kind == "tool_execution_end" and ev.get("isError"):
            tool_errors += 1
        elif kind == "agent_end":
            finished = True
            messages = _dicts(ev.get("messages"))
    assistant = [m for m in messages if m.get("role") == "assistant"]
    # input excludes cache reads (both harnesses): on a long run cache reads are most tokens.
    usage: dict[str, Any] = {"input": 0, "output": 0, "cache_read": 0, "cost_usd": 0.0}
    for m in assistant:
        u = m.get("usage")
        with contextlib.suppress(TypeError, ValueError, AttributeError):
            usage["input"] += int(u.get("input") or 0)
            usage["output"] += int(u.get("output") or 0)
            usage["cache_read"] += int(u.get("cacheRead") or 0)
            usage["cost_usd"] += float((u.get("cost") or {}).get("total") or 0)
    usage["cost_usd"] = round(usage["cost_usd"], 6)
    final = ""
    if assistant:
        texts = [c.get("text") for c in _dicts(assistant[-1].get("content"))]
        final = _cap("\n".join(t for t in texts if isinstance(t, str)).strip(), path)
    return {
        "finished": finished,
        "stop_reason": assistant[-1].get("stopReason") if assistant else None,
        "turns": len(assistant),
        "tools": dict(tools),
        "tool_errors": tool_errors,
        "usage": usage,
        "final_message": final,
    }


def tail(path: Path, n: int = TAIL_LINES) -> str:
    """Last n lines of a text file ('' if missing)."""
    if not path.exists():
        return ""
    return "\n".join(path.read_text(errors="replace").splitlines()[-n:])


def name_status(base_tree: str, new_tree: str, cwd: Path) -> list[str]:
    """'M\\tpath' lines between two trees, NUL-safe for any file name."""
    raw = git_raw(
        "diff-tree", "-r", "-z", "--no-renames", "--name-status", base_tree, new_tree, cwd=cwd
    )
    fields = raw.decode(errors="replace").split("\0")
    return [f"{s}\t{p}" for s, p in zip(fields[0::2], fields[1::2], strict=False) if s]


def emit_file(result: dict[str, Any], artifacts: Path | None) -> str:
    """Keep a copy of the result next to the artifacts; return the JSON text."""
    text = json.dumps(result, indent=2, ensure_ascii=False)
    if artifacts:
        with contextlib.suppress(OSError):
            (artifacts / "result.json").write_text(text + "\n")
    return text


def emit(result: dict[str, Any], artifacts: Path | None) -> None:
    """Print the result and keep a copy next to the artifacts."""
    print(emit_file(result, artifacts), flush=True)


# --------------------------------------------------------------------------- main


def parse_args(argv: list[str]) -> argparse.Namespace:
    """Command-line interface."""
    p = argparse.ArgumentParser(
        prog="delegate",
        description="Run a task on a pi or opencode executor in a throwaway git clone; print JSON.",
    )
    p.add_argument("task", nargs="?", help="the task text, or '-' to read it from stdin")
    p.add_argument("--task-file", type=Path, help="read the task from FILE")
    p.add_argument(
        "--harness",
        choices=HARNESSES,
        default=os.environ.get("DELEGATE_HARNESS") or "pi",
        help="executor harness (default $DELEGATE_HARNESS or pi)",
    )
    p.add_argument(
        "--model",
        help=f"provider/model; pi: default $DELEGATE_MODEL or {DEFAULT_MODEL}; opencode: "
        "required (or $DELEGATE_OPENCODE_MODEL), e.g. opencode/<id> or opencode-go/<id>, "
        "'#variant' allowed",
    )
    p.add_argument(
        "--chain",
        help="run a named fallback chain instead of one model: "
        f"{', '.join(CHAINS)} or $DELEGATE_CHAIN_<NAME>; excludes --model and --harness",
    )
    p.add_argument("--thinking", help="pi thinking level (default off); pi only")
    p.add_argument("--tools", help="pi tool allowlist, e.g. read,edit,bash; pi only")
    p.add_argument(
        "--check", help="shell command run on a clean checkout of the patch tree (+ links)"
    )
    p.add_argument(
        "--timeout",
        type=float,
        default=DEFAULT_TIMEOUT,
        help=f"executor wall-clock limit in seconds (default {DEFAULT_TIMEOUT})",
    )
    p.add_argument(
        "--check-timeout",
        type=float,
        default=DEFAULT_TIMEOUT,
        help=f"check command limit in seconds (default {DEFAULT_TIMEOUT})",
    )
    p.add_argument(
        "--base",
        default="worktree",
        help="starting point: 'worktree' (default: current files, uncommitted included) "
        "or any git revision",
    )
    p.add_argument(
        "--link",
        action="append",
        default=[],
        metavar="PATH",
        help="symlink this repo-relative (usually ignored) path into the clone: venvs, "
        "fetched dependencies, build caches; repeatable; never part of the patch",
    )
    p.add_argument(
        "--keep-alive",
        default=DEFAULT_KEEP_ALIVE,
        help=f"Ollama keep_alive after the run (default {DEFAULT_KEEP_ALIVE})",
    )
    p.add_argument(
        "--server-wait",
        type=float,
        default=DEFAULT_SERVER_WAIT,
        help="llama-server providers: seconds to wait while /health reports loading "
        f"(default {DEFAULT_SERVER_WAIT})",
    )
    p.add_argument("--keep", action="store_true", help="keep the clone after the run")
    p.add_argument(
        "--out",
        type=Path,
        default=Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "delegate",
        help="artifact root (default $XDG_CACHE_HOME/delegate)",
    )
    args = p.parse_args(argv)
    if args.task_file:
        args.task = args.task_file.read_text()
    elif args.task == "-":
        args.task = sys.stdin.read()
    if not args.task or not args.task.strip():
        p.error("a task is required (argument, '-' for stdin, or --task-file)")
    args.out = args.out.expanduser().resolve()
    if args.chain:
        if args.model or "--harness" in argv:
            p.error("--chain excludes --model and --harness: the chain names both")
        try:
            args.entries = chain_entries(args.chain)
        except ValueError as err:
            p.error(str(err))
        return args
    if args.harness not in HARNESSES:
        p.error(f"--harness / $DELEGATE_HARNESS must be one of {', '.join(HARNESSES)}")
    if args.harness == "pi":
        args.model = args.model or os.environ.get("DELEGATE_MODEL") or DEFAULT_MODEL
        args.thinking = args.thinking or "off"
    else:
        # No default: an opencode model id means a cloud provider unless the owner configured
        # otherwise, and code must not leave the machine by default.
        args.model = args.model or os.environ.get("DELEGATE_OPENCODE_MODEL")
        if not args.model:
            p.error("--harness opencode needs --model (list: opencode models)")
        if args.thinking or args.tools:
            p.error(
                "--thinking and --tools are pi options; with opencode pick a reasoning variant "
                "as --model provider/model#variant"
            )
    if "/" not in args.model:
        p.error("--model must be provider/id, e.g. ollama/qwen3.8-unsloth:27b-ud-q4_K_XL")
    args.entries = [(args.harness, args.model)]
    return args


def chain_entries(name: str) -> list[tuple[str, str]]:
    """The (harness, model) entries of a named chain; ValueError when unknown or malformed."""
    raw = os.environ.get(f"DELEGATE_CHAIN_{name.upper().replace('-', '_')}")
    items = [e.strip() for e in raw.split(",") if e.strip()] if raw else list(CHAINS.get(name, ()))
    if not items:
        names = sorted({*CHAINS, *(k[15:].lower() for k in os.environ if k.startswith("DELEGATE_CHAIN_"))})
        raise ValueError(f"--chain {name}: unknown chain (known: {', '.join(names)})")
    entries = []
    for item in items:
        harness, _, model = item.partition(":")
        if harness not in HARNESSES or "/" not in model:
            raise ValueError(f"--chain {name}: bad entry {item!r}, want harness:provider/model")
        entries.append((harness, model))
    return entries


def for_entry(args: argparse.Namespace, harness: str, model: str) -> argparse.Namespace:
    """args for one chain entry: --thinking and --tools apply to pi entries only."""
    a = argparse.Namespace(**vars(args))
    a.harness, a.model = harness, model
    a.thinking = (args.thinking or "off") if harness == "pi" else None
    a.tools = args.tools if harness == "pi" else None
    return a


def falls_back(result: dict[str, Any]) -> bool:
    """True when an attempt failed before doing any work, so the next chain entry may run.

    The backend was down, or the executor ran and errored without a single tool call and without a
    change (a quota, an unknown model, a refused key). A failed check, a timeout or any error after
    tool calls is a verdict on this model's work, not an availability problem: no fallback.
    """
    if result.get("status") == "backend_down":
        return True
    executor = result.get("executor") or {}
    return (
        result.get("status") == "error"
        and bool(executor)
        and not executor.get("tools")
        and not result.get("changed_files")
    )


def free_zen(model: str) -> bool:
    """An OpenCode Zen free model: they all draw on one free-usage quota."""
    return model.startswith("opencode/") and model.endswith("-free")


def preflight(
    provider: str,
    model_id: str,
    args: argparse.Namespace,
    result: dict[str, Any],
    state: dict[str, Any],
) -> None:
    """Make sure a local backend can serve the model; record what it reports."""
    state["ollama"] = (base := ollama_url(provider)), model_id
    if base:
        result["warmup_s"] = round(ollama_warm(base, model_id, args.keep_alive), 1)
    elif provider in LLAMA_PROVIDERS:
        result["server"], warnings = llama_preflight(provider, model_id, args.server_wait)
        if warnings:
            result["warnings"] = warnings


def run(args: argparse.Namespace, result: dict[str, Any], state: dict[str, Any]) -> None:  # noqa: PLR0915
    """The pipeline; fills `result`, records what needs cleanup in `state`."""
    provider, model_id = args.model.split("/", 1)
    try:
        top = git("rev-parse", "--show-toplevel", cwd=Path.cwd())
    except DelegateError as err:
        raise SetupError(f"not inside a git repository: {err}") from err
    repo = Path(top)
    if args.out.is_relative_to(repo):
        raise SetupError(f"--out {args.out} is inside the repository; it would enter the snapshot")
    if args.harness == "pi":
        exe = os.environ.get("DELEGATE_PI") or shutil.which("pi")
        if not exe:
            raise SetupError("pi not found on PATH (npm i -g @earendil-works/pi-coding-agent)")
    else:
        exe = os.environ.get("DELEGATE_OPENCODE") or shutil.which("opencode")
        if not exe:
            raise SetupError("opencode not found on PATH (https://opencode.ai/docs/)")
    links = [normalise_link(rel, repo) for rel in args.link]

    run_id = time.strftime("%Y%m%d-%H%M%S-") + secrets.token_hex(2)
    artifacts = args.out / run_id
    artifacts.mkdir(parents=True)
    state["artifacts"] = artifacts
    task_file = artifacts / "task.md"
    task_file.write_text(args.task)
    result |= {"id": run_id, "repo": str(repo), "artifacts": str(artifacts)}

    commit, described = base_commit_for(repo, args.base, artifacts)
    result["base"] = {"from": described, "commit": commit}

    if args.harness == "pi":  # opencode's providers live in its own config, not pi's models.json
        preflight(provider, model_id, args, result, state)

    workdir = artifacts / "wt"
    state["workdir"] = workdir
    make_clone(repo, workdir, commit)
    place_links(repo, workdir, links)

    # The executor gets no pointer to the caller's repo. Popen(cwd=) does not update PWD, and
    # opencode (Bun) takes its project directory from PWD: a stale value pointing at the
    # caller's repo made it edit the real tree instead of the clone. No bytecode: an executor
    # that runs Python would otherwise add .pyc files to the patch.
    pi_env = {**base_env(), "PWD": str(workdir), "PYTHONDONTWRITEBYTECODE": "1"}
    pi_env.pop("OLDPWD", None)
    if args.harness == "pi":
        # pi's @file keeps the task out of argv (no option parsing of a leading '-' or '@',
        # no ARG_MAX limit).
        cmd = [exe, *PI_FLAGS, "--thinking", args.thinking, "--model", args.model]
        cmd += ["--append-system-prompt", PREAMBLE]
        if args.tools:
            cmd += ["--tools", args.tools]
        cmd.append(f"@{task_file}")
        exe_env, parse = pi_env, parse_pi_events
    else:
        # opencode has no system-prompt option: the preamble leads the message, sent on stdin
        # (no argv size limit, no option parsing, no re-quoting; see OPENCODE_FLAGS).
        prompt = artifacts / "prompt.md"
        prompt.write_text(f"{PREAMBLE}\n\n# Task\n\n{args.task}")
        cmd = [exe, *OPENCODE_FLAGS, "--model", args.model]
        exe_env, parse = {**pi_env, **OPENCODE_ENV}, parse_opencode_events
    state["executor_started"] = True
    events = artifacts / "events.jsonl"
    err = artifacts / f"{args.harness}.err"
    stdin = prompt if args.harness == "opencode" else None
    code, exe_s = run_bounded(cmd, workdir, exe_env, events, err, args.timeout, stdin)
    summary = parse(events)
    result["final_message"] = summary.pop("final_message")
    result["executor"] = {
        "exit": code,
        "elapsed_s": round(exe_s, 1),
        **summary,
        "stderr_tail": tail(err, 10),
    }

    if not (workdir / ".git").is_dir():
        raise DelegateError("the executor destroyed the clone's .git; no patch can be taken")
    new_tree = snapshot_tree(workdir, commit, links, artifacts)
    base_tree = git("rev-parse", f"{commit}^{{tree}}", cwd=workdir)
    changed = name_status(base_tree, new_tree, workdir)
    patch = artifacts / "patch.diff"
    patch.write_bytes(git_raw("diff-tree", *DIFF_FLAGS, base_tree, new_tree, cwd=workdir))
    result["changed_files"] = changed
    result["diff_stat"] = git("diff-tree", "--shortstat", base_tree, new_tree, cwd=workdir)
    result["patch"] = str(patch) if changed else None
    if changed:
        result["apply"] = f"git -C {repo} apply {patch}"

    if args.check:
        # Check exactly the patch: a clean checkout of the new tree, plus the links only.
        new_commit = commit_tree(new_tree, commit, workdir)
        git("checkout", "--quiet", "--force", "--detach", new_commit, cwd=workdir)
        git("clean", "-ffdxq", cwd=workdir)
        place_links(repo, workdir, links)
        check_env = {**pi_env, "DELEGATE_REPO": str(repo)}
        log = artifacts / "check.log"
        check_code, check_s = run_bounded(
            ["bash", "-c", args.check], workdir, check_env, log, log, args.check_timeout
        )
        result["check"] = {
            "cmd": args.check,
            "exit": "timeout" if check_code is None else check_code,
            "elapsed_s": round(check_s, 1),
            "tail": tail(log),
        }

    stop = summary["stop_reason"]
    if code is None:
        result["status"] = "timeout"
    elif code != 0 or not summary["finished"] or stop in ("error", "aborted"):
        result["status"] = "error"
        result["error"] = (
            f"{args.harness} exited {code}"
            + ("" if summary["finished"] else " without finishing the agent loop")
            + (f"; last stop reason: {stop}" if stop in ("error", "aborted") else "")
            + (f"; {summary['provider_error']}" if summary.get("provider_error") else "")
        )
    elif args.check and result["check"]["exit"] != 0:
        result["status"] = "check_failed"
    else:
        result["status"] = "ok"


def arm_signals() -> None:
    """Turn SIGINT/SIGTERM/SIGHUP into Interrupted, so cleanup and the report still happen."""
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, _on_signal)


def attempt(args: argparse.Namespace) -> tuple[dict[str, Any], dict[str, Any], int]:
    """One delegate run on one model: run the pipeline, always clean up; return (result, state, rc)."""
    t_start = time.monotonic()
    result: dict[str, Any] = {
        "status": "error",
        "harness": args.harness,
        "model": args.model,
        "thinking": args.thinking,
    }
    state: dict[str, Any] = {"executor_started": False}
    rc = 1
    try:
        run(args, result, state)
        rc = 0 if result["status"] == "ok" else 1
    except SetupError as err:
        result |= {"status": "error", "error": str(err)}
        rc = 2
    except BackendDownError as err:
        result |= {"status": "backend_down", "error": str(err)}
    except DelegateError as err:
        result |= {"status": "error", "error": str(err)}
        rc = 1 if state["executor_started"] else 2
    except Interrupted as sig:
        result |= {"status": "interrupted", "error": f"signal {sig.signum}"}
        rc = 128 + sig.signum
    except Exception as err:  # noqa: BLE001 -- report every failure as JSON, keep artifacts
        result |= {"status": "error", "error": f"internal: {type(err).__name__}: {err}"}
        if art := state.get("artifacts"):
            with contextlib.suppress(OSError):
                (art / "traceback.txt").write_text(traceback.format_exc())
    finally:
        for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(sig, signal.SIG_IGN)
        reap_descendants()
        workdir = state.get("workdir")
        if workdir and not args.keep:
            shutil.rmtree(workdir, ignore_errors=True)
        result["workdir"] = str(workdir) if workdir and args.keep and workdir.exists() else None
        base, model_id = state.get("ollama", (None, None))
        if base:
            with contextlib.suppress(BackendDownError):
                payload = {"model": model_id, "keep_alive": args.keep_alive}
                ollama_post(f"{base}/api/generate", payload, timeout=30)
        result["elapsed_s"] = round(time.monotonic() - t_start, 1)
    return result, state, rc


def main(argv: list[str]) -> int:
    """Entry point: one attempt, or a chain of them; always print one JSON object."""
    args = parse_args(argv)
    t_start = time.monotonic()
    become_subreaper()
    attempts: list[dict[str, Any]] = []
    result: dict[str, Any] = {}
    state: dict[str, Any] = {}
    rc = 1
    zen_quota_out = False
    for harness, model in args.entries:
        if zen_quota_out and free_zen(model):
            attempts.append({"harness": harness, "model": model, "status": "skipped",
                             "error": "OpenCode Zen free-usage quota exhausted earlier in the chain"})
            continue
        arm_signals()
        result, state, rc = attempt(for_entry(args, harness, model))
        attempts.append({k: result.get(k) for k in ("harness", "model", "status", "error", "artifacts")})
        if args.chain and len(attempts) < len(args.entries) and falls_back(result):
            if free_zen(model) and (result.get("executor") or {}).get("provider_error_type") == "provider.quota":
                zen_quota_out = True
            with contextlib.suppress(OSError, KeyError):  # keep the skipped attempt's own report
                emit_file(result, state.get("artifacts"))
            continue
        break
    if args.chain:
        result["chain"] = {"name": args.chain, "attempts": attempts}
        result["elapsed_s"] = round(time.monotonic() - t_start, 1)
    emit(result, state.get("artifacts"))
    return rc

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
