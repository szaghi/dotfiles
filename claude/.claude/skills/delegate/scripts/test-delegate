#!/usr/bin/env bash
# shellcheck disable=SC2015  # 'A && ok || bad': ok() always returns 0, so bad runs only when A fails
# test-delegate: smoke suite for the delegate script.
#
#   test-delegate            offline cases (fake pi) + live case (real pi + a local model;
#                            DELEGATE_TEST_MODEL picks it, e.g. llamacpp/llama)
#   test-delegate --offline  offline cases only: no model, no network
#   DELEGATE_TEST_OPENCODE_MODEL=opencode/<id> test-delegate   adds a live opencode case
#
# Offline cases swap pi for a fake (DELEGATE_PI) that edits files and prints a minimal
# agent_end event, and use a non-Ollama provider so no warm-up runs. Each case asserts
# on the JSON result and on the invariants: worktree removed, real index untouched,
# real working tree unchanged. Exit status: number of failed cases.
set -u
trap '' PIPE

here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
DELEGATE="$here/delegate"
LIVE_MODEL="${DELEGATE_TEST_MODEL:-ollama/qwen3.8-unsloth:27b-ud-q4_K_XL}"
offline=0
[[ "${1:-}" == "--offline" ]] && offline=1

work=$(mktemp -d "${TMPDIR:-/tmp}/test-delegate.XXXXXX")
trap 'rm -rf "$work"' EXIT
export XDG_CACHE_HOME="$work/cache"
pass=0 fail=0

ok()  { printf '  ok    %s\n' "$1"; pass=$((pass + 1)); }
bad() { printf '  FAIL  %s\n' "$1"; [[ -n "${2:-}" ]] && printf '%s\n' "$2" | sed 's/^/        /'; fail=$((fail + 1)); }

# jq-free JSON field access: jget FILE EXPR (python expression on `r`)
jget() { python3 -c "import json,sys; r=json.load(open(sys.argv[1])); print($2)" "$1"; }

# --- fake pi ------------------------------------------------------------------------
fake="$work/fake-pi"
cat >"$fake" <<'EOF'
#!/usr/bin/env bash
# Modes via FAKE_PI_MODE: edit (default), sleep, fail, assert-dirty, assert-link, binary-ws,
# provider-error, bg, git-refs, ignored-helper, assert-task, latin1, garbage
emit() { printf '%s\n' '{"type":"tool_execution_start","toolName":"edit"}' \
  '{"type":"agent_end","messages":[{"role":"user","content":[]},{"role":"assistant","stopReason":"stop","usage":{"input":10,"output":5,"cacheRead":30,"cost":{"total":0.0012}},"content":[{"type":"text","text":"done"}]}]}'; }
case "${FAKE_PI_MODE:-edit}" in
  edit)  sed -i 's/a - b/a + b/' calc.py; emit ;;
  sleep) sleep 3173 ;;
  fail)  echo "boom" >&2; exit 3 ;;
  assert-dirty)
    grep -q 'DIRTY' notes.txt || { echo "uncommitted edit missing" >&2; exit 4; }
    [[ -f untracked.txt ]] || { echo "untracked file missing" >&2; exit 4; }
    [[ ! -e ignored.log ]] || { echo "ignored file leaked" >&2; exit 4; }
    sed -i 's/a - b/a + b/' calc.py; emit ;;
  assert-link)
    [[ -f .venv/marker ]] || { echo "linked .venv missing" >&2; exit 4; }
    [[ -z "${DELEGATE_REPO:-}" ]] || { echo "DELEGATE_REPO leaked to the executor" >&2; exit 4; }
    sed -i 's/a - b/a + b/' calc.py; emit ;;
  binary-ws) printf 'd  \n' >>notes.txt; printf '\x00\x01\x02bin\xff' >zz.bin; emit ;;
  provider-error)
    printf '%s\n' '{"type":"agent_end","messages":[{"role":"assistant","stopReason":"error","usage":{},"content":[]}]}' ;;
  bg) setsid sleep 3171 </dev/null >/dev/null 2>&1 & sed -i 's/a - b/a + b/' calc.py; emit ;;
  git-refs)
    echo stash-me >>notes.txt; git stash -q; git checkout -qb exec-branch
    sed -i 's/a - b/a + b/' calc.py; git -c user.email=e@e -c user.name=e commit -qam exec; emit ;;
  ignored-helper) echo 'print(1)' >main.py; echo h >helper.log; emit ;;
  assert-task)
    last="${*: -1}"
    [[ "$last" == @* ]] && grep -q -- '^- rename foo' "${last#@}" || { echo "task not passed as @file" >&2; exit 4; }
    sed -i 's/a - b/a + b/' calc.py; emit ;;
  latin1) printf 'perch\xe8\n' >f.txt; emit ;;
  garbage) printf '%s\n' 42 '"text"' '{"type":"agent_end","messages":null}' '[1]'; emit ;;
esac
EOF
chmod +x "$fake"

new_repo() {
  local r="$work/repo-$1"
  mkdir -p "$r" && cd "$r" || exit 99
  git init -q && git config user.email t@t && git config user.name t
  git config commit.gpgsign false
  printf 'def add(a, b):\n    return a - b\n' >calc.py
  printf 'notes\n' >notes.txt
  printf '*.log\n.venv/\n' >.gitignore
  git add . && git commit -qm init
  echo "$r"
}

# invariants: no extra worktree, empty real index, working tree as before
invariants() {
  local name=$1 before=$2
  local wts; wts=$(git worktree list | wc -l)
  [[ "$wts" == 1 ]] || { bad "$name: worktree left behind" "$(git worktree list)"; return; }
  [[ -z "$(git diff --cached --name-only)" ]] || { bad "$name: real index touched"; return; }
  [[ "$(git status --porcelain)" == "$before" ]] || { bad "$name: working tree changed"; return; }
  ok "$name: invariants (worktree removed, index and tree untouched)"
}

fake_run() { DELEGATE_PI="$fake" "$DELEGATE" --model fake/x "$@" "fix calc.py" >"$work/out.json" 2>"$work/err"; }

echo "offline cases"

# 1. usage error
"$DELEGATE" >/dev/null 2>&1; [[ $? == 2 ]] && ok "no task -> exit 2" || bad "no task -> exit 2"

# 2. not a git repository
mkdir -p "$work/plain" && cd "$work/plain" || exit 99
DELEGATE_PI="$fake" "$DELEGATE" --model fake/x "x" >"$work/out.json" 2>/dev/null; rc=$?
[[ $rc == 2 && "$(jget "$work/out.json" 'r["status"]')" == error ]] \
  && ok "not a repo -> status error, exit 2" || bad "not a repo" "$(cat "$work/out.json")"

# 3. backend down (Ollama provider pointed at a dead port)
cd "$(new_repo down)" || exit 99
DELEGATE_OLLAMA_URL=http://127.0.0.1:9 DELEGATE_PI="$fake" "$DELEGATE" --model ollama/x "x" \
  >"$work/out.json" 2>/dev/null; rc=$?
[[ $rc == 1 && "$(jget "$work/out.json" 'r["status"]')" == backend_down ]] \
  && ok "dead Ollama -> status backend_down, exit 1" || bad "backend_down" "$(cat "$work/out.json")"
invariants "backend_down" ""

# 4. ok on a dirty tree: uncommitted + untracked files visible, ignored ones not
cd "$(new_repo dirty)" || exit 99
echo DIRTY >>notes.txt; echo new >untracked.txt; echo junk >ignored.log
before=$(git status --porcelain)
FAKE_PI_MODE=assert-dirty fake_run --check 'python3 -c "import calc; assert calc.add(2,3)==5"'; rc=$?
st=$(jget "$work/out.json" 'r["status"]')
files=$(jget "$work/out.json" '" ".join(r["changed_files"])')
if [[ $rc == 0 && $st == ok && "$files" == "M	calc.py" ]]; then
  ok "dirty tree -> status ok, diff = calc.py only"
else
  bad "dirty tree" "rc=$rc status=$st files=[$files] $(tail -3 "$work/err")"
fi
patch=$(jget "$work/out.json" 'r["patch"]')
git apply --check "$patch" 2>/dev/null && ok "patch applies to the real tree" || bad "patch does not apply"
u=$(jget "$work/out.json" 'r["executor"]["usage"]')
[[ "$u" == "{'input': 10, 'output': 5, 'cache_read': 30, 'cost_usd': 0.0012}" ]] \
  && ok "pi usage -> cache reads and cost reported" || bad "pi usage" "$u"
invariants "dirty tree" "$before"

# 5. check failure
cd "$(new_repo checkfail)" || exit 99
fake_run --check 'echo failing-check; exit 7'; rc=$?
[[ $rc == 1 && "$(jget "$work/out.json" 'r["status"]')" == check_failed \
   && "$(jget "$work/out.json" 'r["check"]["exit"]')" == 7 ]] \
  && ok "check exit 7 -> status check_failed" || bad "check_failed" "$(cat "$work/out.json")"
invariants "check_failed" ""

# 6. executor timeout: killed, reported, cleaned up
cd "$(new_repo timeout)" || exit 99
t0=$SECONDS
FAKE_PI_MODE='sleep' fake_run --timeout 2; rc=$?
dt=$((SECONDS - t0))
[[ $rc == 1 && "$(jget "$work/out.json" 'r["status"]')" == timeout && $dt -lt 20 ]] \
  && ok "timeout 2 s -> status timeout in ${dt}s" || bad "timeout" "rc=$rc dt=$dt $(cat "$work/out.json")"
pgrep -f "$fake" >/dev/null && bad "timeout: fake pi still running" || ok "timeout: process group killed"
invariants "timeout" ""

# 7. executor failure
cd "$(new_repo fail)" || exit 99
FAKE_PI_MODE=fail fake_run; rc=$?
[[ $rc == 1 && "$(jget "$work/out.json" 'r["status"]')" == error \
   && "$(jget "$work/out.json" 'r["executor"]["stderr_tail"]')" == boom ]] \
  && ok "pi exit 3 -> status error, stderr captured" || bad "error" "$(cat "$work/out.json")"
invariants "error" ""

# 8. --link: ignored dir reachable, not in the diff, DELEGATE_REPO exported
cd "$(new_repo link)" || exit 99
mkdir .venv && echo x >.venv/marker
before=$(git status --porcelain)
FAKE_PI_MODE=assert-link fake_run --link .venv; rc=$?
files=$(jget "$work/out.json" '" ".join(r["changed_files"])')
[[ $rc == 0 && "$files" == "M	calc.py" ]] \
  && ok "--link .venv -> visible to executor, absent from diff" || bad "--link" "rc=$rc files=[$files] $(cat "$work/out.json")"
invariants "link" "$before"

# 9. --keep leaves the worktree, then it can be removed
cd "$(new_repo keep)" || exit 99
fake_run --keep
wt=$(jget "$work/out.json" 'r["workdir"]')
[[ -d "$wt" && "$(git -C "$wt" diff --name-only)" == calc.py ]] \
  && ok "--keep -> clone kept with the edit" || bad "--keep" "$(cat "$work/out.json")"
rm -rf "$wt"

# 10. --base HEAD ignores uncommitted changes
cd "$(new_repo base)" || exit 99
echo DIRTY >>notes.txt
FAKE_PI_MODE=assert-dirty fake_run --base HEAD; rc=$?
[[ $rc == 1 && "$(jget "$work/out.json" 'r["executor"]["exit"]')" == 4 \
   && "$(jget "$work/out.json" 'r["executor"]["stderr_tail"]')" == "uncommitted edit missing" ]] \
  && ok "--base HEAD -> uncommitted edit not visible" || bad "--base HEAD" "$(cat "$work/out.json")"

# apply PATCH to a copy of the current repo; extra git -c options first
apply_copy() {
  rm -rf "$work/copy" && cp -a . "$work/copy" && git -C "$work/copy" -c apply.whitespace=nowarn apply "$1"
}

# 11. binary file last + trailing whitespace on the last hunk line: exact bytes
cd "$(new_repo binws)" || exit 99
FAKE_PI_MODE=binary-ws fake_run; rc=$?
patch=$(jget "$work/out.json" 'r["patch"]')
if [[ $rc == 0 ]] && apply_copy "$patch" && [[ "$(tail -1 "$work/copy/notes.txt")" == "d  " ]] \
   && cmp -s "$work/copy/zz.bin" <(printf '\x00\x01\x02bin\xff'); then
  ok "binary last + trailing whitespace -> patch applies, bytes exact"
else bad "binary-ws" "rc=$rc $(head -c 600 "$patch" 2>/dev/null)"; fi
invariants "binary-ws" ""

# 12. hostile diff config: noprefix, color=always, textconv driver
cd "$(new_repo hostile)" || exit 99
git config diff.noprefix true; git config color.diff always; git config color.ui always
git config diff.up.textconv 'tr a-z A-Z'; echo '*.py diff=up' >.gitattributes
git add .gitattributes && git commit -qm attrs
fake_run; rc=$?
patch=$(jget "$work/out.json" 'r["patch"]')
[[ $rc == 0 ]] && apply_copy "$patch" && grep -q 'a + b' "$work/copy/calc.py" \
  && ok "noprefix + color + textconv config -> patch applies" || bad "hostile config" "$(head -c 400 "$patch")"
invariants "hostile config" ""

# 13. provider error inside an otherwise clean exit
cd "$(new_repo provider)" || exit 99
FAKE_PI_MODE=provider-error fake_run --check true; rc=$?
[[ $rc == 1 && "$(jget "$work/out.json" 'r["status"]')" == error ]] \
  && ok "stopReason error with exit 0 -> status error" || bad "provider error" "$(cat "$work/out.json")"

# 14. no descendant survives: detached executor child, detached check child
cd "$(new_repo bg)" || exit 99
FAKE_PI_MODE='bg' fake_run --check 'setsid sleep 3172 </dev/null >/dev/null 2>&1 & true'; rc=$?
sleep 0.5
if [[ $rc == 0 ]] && ! pgrep -f '^sleep 317[12]$' >/dev/null; then
  ok "detached executor and check children reaped"
else bad "process leak" "rc=$rc $(pgrep -af '^sleep 317[12]$')"; pkill -f '^sleep 317[12]$'; fi
invariants "bg" ""

# 15. SIGTERM: cleanup, JSON, 143, executor gone
cd "$(new_repo signal)" || exit 99
FAKE_PI_MODE='sleep' DELEGATE_PI="$fake" "$DELEGATE" --model fake/x "x" >"$work/out.json" 2>/dev/null &
dpid=$!
sleep 1.5; kill -TERM "$dpid"; wait "$dpid"; rc=$?
sleep 0.5
art=$(jget "$work/out.json" 'r.get("artifacts","")' 2>/dev/null)
if [[ $rc == 143 && "$(jget "$work/out.json" 'r["status"]')" == interrupted ]] \
   && ! pgrep -f '^sleep 3173$' >/dev/null && [[ -n "$art" && ! -e "$art/wt" ]]; then
  ok "SIGTERM -> status interrupted, exit 143, executor killed, clone removed"
else bad "SIGTERM" "rc=$rc $(cat "$work/out.json") $(pgrep -af '^sleep 3173$')"; pkill -f '^sleep 3173$'; fi
invariants "signal" ""

# 16. executor git commit/branch/stash stay in its clone
cd "$(new_repo refs)" || exit 99
FAKE_PI_MODE=git-refs fake_run; rc=$?
if [[ $rc == 0 && -z "$(git branch --list exec-branch)" && -z "$(git stash list)" ]] \
   && [[ "$(jget "$work/out.json" '" ".join(r["changed_files"])')" == "M	calc.py" ]]; then
  ok "executor commit/branch/stash -> no ref or stash leaks, edit still in patch"
else bad "refs" "rc=$rc branches=[$(git branch --list)] stash=[$(git stash list)]"; fi
invariants "refs" ""

# 17. the caller's other (temporarily missing) worktrees are not pruned
cd "$(new_repo prune)" || exit 99
git worktree add -q -b feature "$work/wt-feature" && mv "$work/wt-feature" "$work/wt-away"
fake_run
git worktree list --porcelain | grep -q "wt-feature" \
  && ok "missing sibling worktree not pruned" || bad "sibling worktree pruned"
mv "$work/wt-away" "$work/wt-feature" && git worktree remove --force "$work/wt-feature"

# 18. the check runs on the patch tree: an ignored helper file does not exist there
cd "$(new_repo patchcheck)" || exit 99
FAKE_PI_MODE=ignored-helper fake_run --check 'test -f main.py && test -f helper.log'; rc=$?
[[ $rc == 1 && "$(jget "$work/out.json" 'r["status"]')" == check_failed \
   && "$(jget "$work/out.json" '" ".join(r["changed_files"])')" == "A	main.py" ]] \
  && ok "check sees only the patch (ignored helper absent) -> check_failed" || bad "check on patch" "$(cat "$work/out.json")"

# 19. a task starting with '- ' reaches pi as @file
cd "$(new_repo task)" || exit 99
FAKE_PI_MODE=assert-task DELEGATE_PI="$fake" "$DELEGATE" --model fake/x "- rename foo" >"$work/out.json" 2>/dev/null; rc=$?
[[ $rc == 0 ]] && ok "task '- rename foo' passed as @file" || bad "task as @file" "$(cat "$work/out.json")"

# 20. non-UTF-8 file content
cd "$(new_repo latin1)" || exit 99
FAKE_PI_MODE=latin1 fake_run; rc=$?
patch=$(jget "$work/out.json" 'r["patch"]')
[[ $rc == 0 ]] && apply_copy "$patch" && cmp -s "$work/copy/f.txt" <(printf 'perch\xe8\n') \
  && ok "Latin-1 file -> status ok, patch exact" || bad "latin1" "$(cat "$work/out.json")"

# 21. malformed event lines
cd "$(new_repo garbage)" || exit 99
FAKE_PI_MODE=garbage fake_run; rc=$?
[[ $rc == 0 && "$(jget "$work/out.json" 'r["status"]')" == ok ]] \
  && ok "malformed events tolerated" || bad "garbage events" "$(cat "$work/out.json")"

# 22. --link with a trailing slash
cd "$(new_repo linkslash)" || exit 99
mkdir .venv && echo x >.venv/marker
FAKE_PI_MODE=assert-link fake_run --link .venv/; rc=$?
[[ $rc == 0 ]] && ok "--link .venv/ accepted" || bad "--link .venv/" "$(cat "$work/out.json")"

# 23. setup errors exit 2 before the executor starts
cd "$(new_repo setup)" || exit 99
fake_run --base nosuchrev; rc1=$?
fake_run --link nosuchdir; rc2=$?
fake_run --link ../outside; rc3=$?
[[ $rc1 == 2 && $rc2 == 2 && $rc3 == 2 ]] && ok "bad --base / --link -> exit 2" \
  || bad "setup exit codes" "base=$rc1 link=$rc2 outside=$rc3"

# --- fake llama-server ---------------------------------------------------------------
# FAKE_SRV: up (default) | loading:N (503 for the first N /health) | stuck (always 503) | noprops
srv="$work/fake-srv.py"
cat >"$srv" <<'EOF'
import http.server, json, os, sys
mode, n_ctx = os.environ.get("FAKE_SRV", "up"), int(os.environ.get("FAKE_NCTX", "32768"))
left = int(mode.split(":")[1]) if mode.startswith("loading:") else 0
class H(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def send(self, code, body=b""):
        self.send_response(code); self.end_headers(); self.wfile.write(body)
    def do_GET(self):
        global left
        if self.path == "/health":
            if mode == "stuck" or left > 0:
                left -= 1; return self.send(503, b'{"status":"loading model"}')
            return self.send(200, b'{"status":"ok"}')
        if self.path == "/props" and mode != "noprops":
            return self.send(200, json.dumps({"model_path": "/m/Qwen3-Coder.gguf",
                "default_generation_settings": {"n_ctx": n_ctx}}).encode())
        self.send(404)
s = http.server.HTTPServer(("127.0.0.1", 0), H)
print(s.server_address[1], flush=True)
s.serve_forever()
EOF
start_srv() {  # start_srv MODE [N_CTX] -> sets $port, $srv_pid
  FAKE_SRV=$1 FAKE_NCTX=${2:-32768} python3 "$srv" >"$work/srv.port" &
  srv_pid=$!
  for _ in $(seq 50); do [[ -s "$work/srv.port" ]] && break; sleep 0.1; done
  port=$(head -1 "$work/srv.port")
}
stop_srv() { kill "$srv_pid" 2>/dev/null; wait "$srv_pid" 2>/dev/null; : >"$work/srv.port"; }
fake_home() {  # fake_home PROVIDER PORT CONTEXT_WINDOW -> $home with a models.json
  home="$work/home-$1"; mkdir -p "$home/.pi/agent"
  printf '{"providers":{"%s":{"baseUrl":"http://127.0.0.1:%s/v1","models":[{"id":"%s","contextWindow":%s}]}}}\n' \
    "$1" "$2" "$3" "$4" >"$home/.pi/agent/models.json"
}
llama_run() {  # llama_run PROVIDER MODEL_ID [delegate args...]
  local prov=$1 id=$2; shift 2
  HOME="$home" DELEGATE_PI="$fake" "$DELEGATE" --model "$prov/$id" "$@" "fix calc.py" \
    >"$work/out.json" 2>"$work/err"
}

# 24. llama.cpp up: server facts reported, no warning
cd "$(new_repo llama-up)" || exit 99
start_srv up 32768; fake_home llamacpp "$port" llama 32768
llama_run llamacpp llama; rc=$?
[[ $rc == 0 && "$(jget "$work/out.json" 'r["server"]["model"]')" == Qwen3-Coder.gguf \
   && "$(jget "$work/out.json" 'r["server"]["n_ctx"]')" == 32768 \
   && "$(jget "$work/out.json" '"warnings" in r')" == False ]] \
  && ok "llamacpp up -> server model + n_ctx reported, no warning" || bad "llamacpp up" "$(cat "$work/out.json")"
stop_srv
invariants "llama up" ""

# 25. contextWindow larger than the server's n_ctx: warned, not fatal
cd "$(new_repo llama-ctx)" || exit 99
start_srv up 8192; fake_home llamacpp "$port" llama 32768
llama_run llamacpp llama; rc=$?
[[ $rc == 0 && "$(jget "$work/out.json" 'r["warnings"][0]')" == *"contextWindow 32768 > server n_ctx 8192"* ]] \
  && ok "contextWindow > n_ctx -> warning, status ok" || bad "ctx warning" "$(cat "$work/out.json")"
stop_srv

# 26. model still loading: waits through 503s
cd "$(new_repo llama-loading)" || exit 99
start_srv loading:3; fake_home llamacpp "$port" llama 32768
llama_run llamacpp llama; rc=$?
[[ $rc == 0 && "$(jget "$work/out.json" 'r["status"]')" == ok ]] \
  && ok "503 x3 then 200 -> waited, status ok" || bad "loading wait" "$(cat "$work/out.json")"
stop_srv

# 27. loading never ends: bounded by --server-wait
cd "$(new_repo llama-stuck)" || exit 99
start_srv stuck; fake_home llamacpp "$port" llama 32768
t0=$SECONDS
llama_run llamacpp llama --server-wait 2; rc=$?
dt=$((SECONDS - t0))
[[ $rc == 1 && "$(jget "$work/out.json" 'r["status"]')" == backend_down && $dt -lt 10 ]] \
  && ok "503 forever, --server-wait 2 -> backend_down in ${dt}s" || bad "stuck server" "rc=$rc dt=$dt $(cat "$work/out.json")"
stop_srv
invariants "llama stuck" ""

# 28. no server: immediate backend_down with the start command
cd "$(new_repo llama-down)" || exit 99
fake_home llamacpp 9 llama 32768
llama_run llamacpp llama; rc=$?
[[ $rc == 1 && "$(jget "$work/out.json" 'r["status"]')" == backend_down \
   && "$(jget "$work/out.json" 'r["error"]')" == *"llm-local-server start --backend llama "* ]] \
  && ok "no llama server -> backend_down with start hint" || bad "llama down" "$(cat "$work/out.json")"

# 29. ik_llama without /props: runs, server model unknown
cd "$(new_repo ik-noprops)" || exit 99
start_srv noprops; fake_home ikllama "$port" ikllama 32768
llama_run ikllama ikllama; rc=$?
[[ $rc == 0 && "$(jget "$work/out.json" 'r["server"]["model"]')" == None \
   && "$(jget "$work/out.json" 'r["server"]["engine"]')" == ikllama ]] \
  && ok "ikllama without /props -> status ok, model unknown" || bad "ik noprops" "$(cat "$work/out.json")"
stop_srv

# --- fake opencode -------------------------------------------------------------------
ocfake="$work/fake-opencode"
cat >"$ocfake" <<'EOF'
#!/usr/bin/env bash
# Modes via FAKE_OC_MODE: edit (default), error, toolerr. Always asserts the headless contract:
# exactly `run --standalone --format json --auto --model M` (no message argument: opencode 2.1
# duplicates and re-quotes argv text), the prompt on stdin byte for byte (FAKE_OC_EXPECT, or the
# file FAKE_OC_EXPECT_FILE, holds the task), the isolation environment, a PWD naming the clone. Like the real one it ends with
# the final text and no step_finish after it.
[[ $# == 7 && "$1 $2 $3 $4 $5 $6" == "run --standalone --format json --auto --model" ]] \
  || { echo "bad argv ($#): $*" >&2; exit 4; }
[[ "${OPENCODE_DISABLE_CLAUDE_CODE:-}" == 1 && "${OPENCODE_CONFIG_CONTENT:-}" == *'"snapshot": false'* \
   && "${OPENCODE_CONFIG_CONTENT:-}" == *'"websearch": "deny"'* ]] || { echo "isolation env missing" >&2; exit 4; }
[[ -z "${DELEGATE_REPO:-}" ]] || { echo "DELEGATE_REPO leaked" >&2; exit 4; }
# bash repairs a stale PWD at startup, so read the environment this process was given.
given=$(tr '\0' '\n' </proc/$$/environ | sed -n 's/^PWD=//p')
[[ "$given" == "$(pwd)" ]] || { echo "stale PWD: $given (cwd $(pwd))" >&2; exit 4; }
python3 -c '
import os, sys
got = sys.stdin.buffer.read().decode()
if os.environ.get("FAKE_OC_EXPECT_FILE"):
    sys.argv[1] = open(os.environ["FAKE_OC_EXPECT_FILE"]).read()
ok = got.startswith("You are an executor") and got.count("You are an executor") == 1
if not ok or not got.endswith("# Task\n\n" + sys.argv[1]):
    sys.exit(f"stdin prompt mismatch: {got[:80]!r} ... {got[-80:]!r}")
' "${FAKE_OC_EXPECT:-fix calc.py}" || exit 4
step='{"type":"step_start","part":{"type":"step-start"}}'
tool='{"type":"tool_use","part":{"type":"tool","tool":"edit","state":{"status":"completed"}}}'
fin='{"type":"step_finish","part":{"type":"step-finish","reason":"tool-calls","cost":0.0005,"tokens":{"input":100,"output":7,"reasoning":3,"cache":{"read":40}}}}'
txt='{"type":"text","part":{"type":"text","messageID":"m2","text":"done"}}'
case "${FAKE_OC_MODE:-edit}" in
  edit) sed -i 's/a - b/a + b/' calc.py; printf '%s\n' "$step" "$tool" "$fin" "$step" "$txt" ;;
  error)
    printf '%s\n' '{"type":"error","error":{"type":"provider.quota","message":"Free usage limit reached"}}'; exit 1 ;;
  toolerr)
    printf '%s\n' "$step" '{"type":"tool_use","part":{"tool":"read","state":{"status":"error","error":"File not found"}}}' "$fin" "$step" "$txt" ;;
  workerror)
    sed -i 's/a - b/a + b/' calc.py
    printf '%s\n' "$step" "$tool" '{"type":"error","error":{"type":"provider.quota","message":"Free usage limit reached"}}'; exit 1 ;;
esac
EOF
chmod +x "$ocfake"
oc_run() {  # oc_run TASK [delegate args...]
  local task=$1; shift
  FAKE_OC_EXPECT="$task" DELEGATE_OPENCODE="$ocfake" "$DELEGATE" --harness opencode --model oc/x "$@" -- "$task" \
    >"$work/out.json" 2>"$work/err"
}

# 30. opencode ok: headless contract, patch, check, summary in pi's shape
cd "$(new_repo oc-ok)" || exit 99
oc_run "fix calc.py" --check 'python3 -c "import calc; assert calc.add(2,3)==5"'; rc=$?
got=$(jget "$work/out.json" 'r["status"], r["harness"], r["changed_files"], r["executor"]["turns"], r["executor"]["tools"], r["executor"]["usage"], r["executor"]["stop_reason"], r["final_message"], r["thinking"]')
[[ $rc == 0 && "$got" == "ok opencode ['M\\tcalc.py'] 2 {'edit': 1} {'input': 100, 'output': 7, 'cache_read': 40, 'cost_usd': 0.0005} None done None" ]] \
  && ok "opencode -> status ok, harness/turns/tools/usage/final reported, no stale stop_reason" \
  || bad "opencode ok" "rc=$rc got=$got $(tail -3 "$work/err")"
[[ -f "$(jget "$work/out.json" 'r["artifacts"]')/opencode.err" ]] && ok "opencode stderr in opencode.err" || bad "opencode.err missing"
invariants "opencode ok" ""

# 31. quotes, backslashes and a leading '-' reach the model unchanged
cd "$(new_repo oc-quote)" || exit 99
oc_run '-rename "foo" to bar; memo defaults to "" and path C:\tmp'; rc=$?
[[ $rc == 0 && "$(jget "$work/out.json" 'r["status"]')" == ok ]] \
  && ok "opencode task with quotes and leading '-' -> stdin byte for byte" || bad "oc quote" "$(head -c 800 "$work/out.json") $(tail -3 "$work/err")"

# 32. provider error event + exit 1 -> status error with the provider's message
cd "$(new_repo oc-err)" || exit 99
FAKE_OC_MODE=error oc_run "fix calc.py"; rc=$?
[[ $rc == 1 && "$(jget "$work/out.json" 'r["status"], r["executor"]["stop_reason"]')" == "error error" \
   && "$(jget "$work/out.json" 'r["error"]')" == *"Free usage limit reached"* ]] \
  && ok "opencode error event -> status error, provider message kept" || bad "oc error" "$(cat "$work/out.json")"
invariants "opencode error" ""

# 33. failed tool calls are counted
cd "$(new_repo oc-toolerr)" || exit 99
FAKE_OC_MODE=toolerr oc_run "fix calc.py"
[[ "$(jget "$work/out.json" 'r["executor"]["tool_errors"]')" == 1 ]] \
  && ok "opencode tool error -> tool_errors 1" || bad "oc toolerr" "$(cat "$work/out.json")"

# 34. a 200 kB task (over the 128 KiB argv string limit) goes through stdin
cd "$(new_repo oc-long)" || exit 99
python3 -c 'import sys; sys.stdout.write("fix calc.py\n" + "x" * 200000)' >"$work/long-task.md"
FAKE_OC_EXPECT_FILE="$work/long-task.md" DELEGATE_OPENCODE="$ocfake" "$DELEGATE" --harness opencode \
  --model oc/x --task-file "$work/long-task.md" >"$work/out.json" 2>"$work/err"; rc=$?
[[ $rc == 0 && "$(jget "$work/out.json" 'r["status"]')" == ok ]] \
  && ok "opencode 200 kB task -> stdin" || bad "oc long" "$(head -c 800 "$work/out.json") $(tail -3 "$work/err")"

# 35. argument rules: model required (DELEGATE_MODEL ignored), pi-only options refused, harness by env
cd "$(new_repo oc-args)" || exit 99
DELEGATE_MODEL=fake/x DELEGATE_OPENCODE="$ocfake" "$DELEGATE" --harness opencode "x" >/dev/null 2>&1
[[ $? == 2 ]] && ok "opencode without --model -> exit 2" || bad "oc no model"
DELEGATE_OPENCODE="$ocfake" "$DELEGATE" --harness opencode --model oc/x --thinking high "x" >/dev/null 2>&1
[[ $? == 2 ]] && ok "opencode --thinking -> exit 2" || bad "oc thinking"
DELEGATE_HARNESS=bogus "$DELEGATE" --model fake/x "x" >/dev/null 2>&1
[[ $? == 2 ]] && ok "DELEGATE_HARNESS=bogus -> exit 2" || bad "bogus harness"
DELEGATE_HARNESS=opencode DELEGATE_OPENCODE="$ocfake" "$DELEGATE" --model oc/x "fix calc.py" >"$work/out.json" 2>"$work/err"  # FAKE_OC_EXPECT default
[[ "$(jget "$work/out.json" 'r["harness"], r["status"]')" == "opencode ok" ]] \
  && ok "DELEGATE_HARNESS=opencode selects opencode" || bad "env harness" "$(head -c 600 "$work/out.json")"

# --- fallback chains ----------------------------------------------------------------
chain_run() {  # chain_run CHAIN_SPEC [delegate args...]: runs chain "t" with the fakes
  local spec=$1; shift
  DELEGATE_CHAIN_T="$spec" DELEGATE_PI="$fake" DELEGATE_OPENCODE="$ocfake" "$DELEGATE" --chain t "$@" "fix calc.py" \
    >"$work/out.json" 2>"$work/err"
}

# 36. a quota error before any work falls through to the next entry
cd "$(new_repo chain-fall)" || exit 99
FAKE_OC_MODE=error chain_run "opencode:opencode/a-free,pi:fake/x" --check 'python3 -c "import calc; assert calc.add(2,3)==5"'; rc=$?
got=$(jget "$work/out.json" 'r["status"], r["model"], [(a["model"], a["status"]) for a in r["chain"]["attempts"]]')
[[ $rc == 0 && "$got" == "ok fake/x [('opencode/a-free', 'error'), ('fake/x', 'ok')]" ]] \
  && ok "chain: quota error -> next entry, attempts recorded" || bad "chain fallback" "rc=$rc got=$got"
invariants "chain fallback" ""

# 37. a Zen quota error skips the other free Zen entries (one shared quota), not paid ones
cd "$(new_repo chain-zen)" || exit 99
FAKE_OC_MODE=error chain_run "opencode:opencode/a-free,opencode:opencode/b-free,pi:fake/x"; rc=$?
got=$(jget "$work/out.json" '[a["status"] for a in r["chain"]["attempts"]]')
[[ $rc == 0 && "$got" == "['error', 'skipped', 'ok']" ]] \
  && ok "chain: Zen quota -> other free Zen entries skipped" || bad "chain zen skip" "rc=$rc got=$got"

# 38. a failed check is a verdict, not an availability problem: no fallback
cd "$(new_repo chain-check)" || exit 99
chain_run "pi:fake/x,pi:fake/y" --check 'exit 7'; rc=$?
got=$(jget "$work/out.json" 'r["status"], len(r["chain"]["attempts"])')
[[ $rc == 1 && "$got" == "check_failed 1" ]] \
  && ok "chain: check_failed -> no fallback" || bad "chain check" "rc=$rc got=$got"

# 39. an error after tool calls (work done, maybe paid for) is not retried elsewhere
cd "$(new_repo chain-work)" || exit 99
FAKE_OC_MODE=workerror chain_run "opencode:opencode/a-free,pi:fake/x"; rc=$?
got=$(jget "$work/out.json" 'r["status"], len(r["chain"]["attempts"])')
[[ $rc == 1 && "$got" == "error 1" ]] \
  && ok "chain: error after work -> no fallback" || bad "chain work" "rc=$rc got=$got"
invariants "chain work" ""

# 40. argument rules: unknown chain, --chain with --model, malformed entry, built-in names
cd "$(new_repo chain-args)" || exit 99
"$DELEGATE" --chain nosuch "x" >/dev/null 2>&1; [[ $? == 2 ]] && ok "unknown chain -> exit 2" || bad "unknown chain"
"$DELEGATE" --chain public --model a/b "x" >/dev/null 2>&1; [[ $? == 2 ]] && ok "--chain with --model -> exit 2" || bad "chain+model"
DELEGATE_CHAIN_T="pi-model-without-harness" "$DELEGATE" --chain t "x" >/dev/null 2>&1
[[ $? == 2 ]] && ok "malformed chain entry -> exit 2" || bad "bad entry"
got=$(python3 - "$DELEGATE" <<'PY'
import sys, importlib.machinery, importlib.util
ld = importlib.machinery.SourceFileLoader("dg", sys.argv[1])
m = importlib.util.module_from_spec(importlib.util.spec_from_loader("dg", ld)); ld.exec_module(m)
print([h for h, _ in m.chain_entries("public")], m.chain_entries("private")[0][1].startswith("ollama/"))
PY
)
[[ "$got" == "['opencode', 'pi', 'pi'] True" ]] && ok "built-in chains: public = free, paid, local; private = local" \
  || bad "built-in chains" "$got"

if [[ $offline == 0 ]]; then
  echo "live case ($LIVE_MODEL)"
  cd "$(new_repo live)" || exit 99
  "$DELEGATE" --model "$LIVE_MODEL" --timeout 600 \
    --check 'python3 -c "import calc; assert calc.add(2,3)==5"' \
    "calc.py has a bug in add(). Fix it." >"$work/out.json" 2>"$work/err"; rc=$?
  st=$(jget "$work/out.json" 'r["status"]')
  files=$(jget "$work/out.json" '" ".join(r.get("changed_files", []))')
  el=$(jget "$work/out.json" 'r.get("elapsed_s")')
  if [[ $rc == 0 && $st == ok && "$files" == "M	calc.py" ]]; then
    ok "live fix -> status ok, check passed, diff = calc.py (${el}s)"
  else
    bad "live fix" "rc=$rc status=$st files=[$files] $(head -c 1500 "$work/out.json")"
  fi
  invariants "live" ""
fi

if [[ $offline == 0 && -n "${DELEGATE_TEST_OPENCODE_MODEL:-}" ]]; then
  echo "live case, opencode ($DELEGATE_TEST_OPENCODE_MODEL)"
  cd "$(new_repo live-oc)" || exit 99
  "$DELEGATE" --harness opencode --model "$DELEGATE_TEST_OPENCODE_MODEL" --timeout 600 \
    --check 'python3 -c "import calc; assert calc.add(2,3)==5"' \
    "calc.py has a bug in add(). Fix it." >"$work/out.json" 2>"$work/err"; rc=$?
  st=$(jget "$work/out.json" 'r["status"]')
  files=$(jget "$work/out.json" '" ".join(r.get("changed_files", []))')
  el=$(jget "$work/out.json" 'r.get("elapsed_s")')
  if [[ $rc == 0 && $st == ok && "$files" == "M	calc.py" ]]; then
    ok "live opencode fix -> status ok, check passed, diff = calc.py (${el}s)"
  else
    bad "live opencode fix" "rc=$rc status=$st files=[$files] $(head -c 1500 "$work/out.json")"
  fi
  invariants "live opencode" ""
fi

printf '%d passed, %d failed\n' "$pass" "$fail"
exit "$fail"
