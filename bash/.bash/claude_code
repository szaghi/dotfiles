_llama_resolve_model() {
    _llama_resolve_model_in "$1" "$LLAMACPP_MODELS_DIR" "$LLAMACPP_DEFAULT_MODEL"
}

# Interactive numbered picker for GGUFs in $models_dir. Lists regular files
# (raw GGUFs) and symlinks (aliases) — both are resolvable. HF cache files
# are deliberately excluded: they can't be loaded by --model NAME until an
# alias is created (see `llama-alias`). Writes the chosen filename (without
# .gguf, suitable for re-feeding to _llama_resolve_model_in) to stdout.
_llama_pick_model() {
    local models_dir="$1" default_model="$2"
    local -a all_files=()
    local f
    if [[ -d "$models_dir" ]]; then
        while IFS= read -r f; do
            all_files+=("$f")
        done < <(find "$models_dir" -maxdepth 2 -name "*.gguf" 2>/dev/null | sort)
    fi
    if (( ${#all_files[@]} == 0 )); then
        printf 'Error: no GGUFs in %s\n' "$models_dir" >&2
        printf 'Pull one with: hf-pull <repo> <file.gguf>\n' >&2
        printf 'Or alias an HF cache entry: llama-alias <name> <substr>...\n' >&2
        return 1
    fi

    # Group split-shard GGUFs under their base name. A shard filename matches
    # <base>-NNNNN-of-MMMMM.gguf — llama-server takes only the first shard via
    # --model and discovers siblings on its own. We hide all but the first.
    #
    # Parallel arrays per displayed entry:
    #   entries[i]    full path to the file the user will load (first shard for splits)
    #   labels[i]     display name (basename, with " (N/M shards)" annotation for splits)
    #   sizes[i]      total bytes (sum of all shards for splits)
    #   warnings[i]   non-empty if not all shards are present
    local -a entries=() labels=() sizes=() warnings=()
    # Map: base -> "shards_present  total_size  expected_total  first_shard_path"
    declare -A grp_count grp_size grp_expected grp_first

    for f in "${all_files[@]}"; do
        local fname="${f##*/}"
        local stem="${fname%.gguf}"
        # Detect shard suffix.
        if [[ "$stem" =~ ^(.*)-([0-9]{5})-of-([0-9]{5})$ ]]; then
            local base="${BASH_REMATCH[1]}"
            local idx="${BASH_REMATCH[2]}"
            local total="${BASH_REMATCH[3]}"
            local sz; sz=$(stat -L -c %s "$f" 2>/dev/null)
            grp_count[$base]=$(( ${grp_count[$base]:-0} + 1 ))
            grp_size[$base]=$(( ${grp_size[$base]:-0} + sz ))
            grp_expected[$base]="$total"
            # The first shard is the canonical entry point for llama-server.
            if [[ "$idx" == "00001" ]]; then
                grp_first[$base]="$f"
            fi
        else
            local sz; sz=$(stat -L -c %s "$f" 2>/dev/null)
            entries+=("$f")
            if [[ -L "$f" ]]; then
                labels+=("${fname} → $(readlink -f "$f")")
            else
                # If the file lives in a subdirectory of models_dir, show the
                # relative path so it's distinguishable from flat entries.
                local rel="${f#"$models_dir"/}"
                if [[ "$rel" == */* ]]; then
                    labels+=("$rel")
                else
                    labels+=("$fname")
                fi
            fi
            sizes+=("$sz")
            warnings+=("")
        fi
    done

    # Emit one entry per shard group.
    local base
    for base in "${!grp_count[@]}"; do
        local count="${grp_count[$base]}"
        local expected="${grp_expected[$base]}"
        local first="${grp_first[$base]:-}"
        if [[ -z "$first" ]]; then
            # No first shard present — group is unloadable. Show it but warn loudly.
            entries+=("")
            labels+=("${base} (split GGUF, MISSING shard 1/$((10#$expected)))")
            sizes+=("${grp_size[$base]}")
            warnings+=("UNLOADABLE")
            continue
        fi
        entries+=("$first")
        if [[ "$count" == "$expected" ]]; then
            labels+=("${base} (${count}/$((10#$expected)) shards)")
            warnings+=("")
        else
            labels+=("${base} (${count}/$((10#$expected)) shards — INCOMPLETE)")
            warnings+=("incomplete")
        fi
        sizes+=("${grp_size[$base]}")
    done

    # Sort entries by label for stable display order. Use a real tab as the
    # delimiter — string concatenation with "\t" yields a literal backslash-t.
    local TAB=$'\t'
    local -a order=()
    local i
    for i in "${!labels[@]}"; do
        order+=("${labels[i]}${TAB}${i}")
    done
    local -a sorted_entries=() sorted_labels=() sorted_sizes=() sorted_warnings=()
    local idx
    while IFS=$'\t' read -r _ idx; do
        [[ -z "$idx" ]] && continue
        sorted_entries+=("${entries[idx]}")
        sorted_labels+=("${labels[idx]}")
        sorted_sizes+=("${sizes[idx]}")
        sorted_warnings+=("${warnings[idx]}")
    done < <(printf '%s\n' "${order[@]}" | sort -f)
    entries=("${sorted_entries[@]}")
    labels=("${sorted_labels[@]}")
    sizes=("${sorted_sizes[@]}")
    warnings=("${sorted_warnings[@]}")

    # Resolve the default to a full path so we can flag it in the list.
    local default_path=""
    if [[ -n "$default_model" ]]; then
        if   [[ -f "$default_model" ]];                       then default_path="$default_model"
        elif [[ -f "${models_dir}/${default_model}" ]];       then default_path="${models_dir}/${default_model}"
        elif [[ -f "${models_dir}/${default_model}.gguf" ]];  then default_path="${models_dir}/${default_model}.gguf"
        fi
    fi

    printf 'Pick a model for the server:\n' >&2
    local default_idx=0 size_h marker disabled_count=0
    for i in "${!entries[@]}"; do
        size_h=$(printf '%s' "${sizes[i]}" \
                 | awk '{ s=$1; u="BKMGT"; n=1
                          while (s>=1024 && n<length(u)) { s/=1024; n++ }
                          printf "%.1f%s", s, substr(u,n,1) }')
        marker=''
        if [[ -n "$default_path" && "${entries[i]}" == "$default_path" ]]; then
            marker='[default]'
            default_idx=$((i+1))
        fi
        if [[ "${warnings[i]}" == "UNLOADABLE" ]]; then
            printf '  --) %-9s %s\n' "$size_h" "${labels[i]}" >&2
            ((disabled_count++))
        else
            printf '  %2d) %-9s %s %s\n' "$((i+1))" "$size_h" "${labels[i]}" "$marker" >&2
        fi
    done
    if (( disabled_count > 0 )); then
        printf '  (%d entry/entries marked -- are unloadable and cannot be picked)\n' \
            "$disabled_count" >&2
    fi

    local prompt
    if (( default_idx > 0 )); then
        prompt="Enter number 1-${#entries[@]}, Enter for default (#${default_idx}), q to abort: "
    else
        prompt="Enter number 1-${#entries[@]}, q to abort: "
    fi

    local reply
    while :; do
        read -r -p "$prompt" reply
        [[ "$reply" =~ ^[Qq]$ ]] && { printf 'Aborted.\n' >&2; return 1; }
        if [[ -z "$reply" ]]; then
            if (( default_idx > 0 )); then
                reply=$default_idx
            else
                printf '  No default — pick a number or q.\n' >&2
                continue
            fi
        fi
        if [[ "$reply" =~ ^[0-9]+$ ]] && (( reply >= 1 && reply <= ${#entries[@]} )); then
            local picked="${entries[reply-1]}"
            if [[ -z "$picked" ]]; then
                printf '  That entry is unloadable (missing first shard). Pick another.\n' >&2
                continue
            fi
            if [[ "${warnings[reply-1]}" == "incomplete" ]]; then
                local confirm
                read -r -p '  Group is incomplete; loading will fail. Pick anyway? [y/N] ' confirm
                [[ "$confirm" =~ ^[Yy]$ ]] || continue
            fi
            # Emit the full path — _llama_resolve_model_in handles `[[ -f $model ]]`
            # directly, so subdir paths like models_dir/BF16/foo-00001-of-N.gguf work.
            printf '%s' "$picked"
            return 0
        fi
        printf '  Invalid choice. Enter 1-%d or q.\n' "${#entries[@]}" >&2
    done
}

_llama_resolve_model_in() {
    local model="${1:-$3}" models_dir="$2"
    if [[ -z "$model" ]]; then
        printf 'Error: no model — set default in claude_code.local or pass --model\n' >&2; return 1
    fi
    if   [[ -f "$model" ]];                             then printf '%s' "$model"
    elif [[ -f "${models_dir}/${model}" ]];             then printf '%s' "${models_dir}/${model}"
    elif [[ -f "${models_dir}/${model}.gguf" ]];        then printf '%s' "${models_dir}/${model}.gguf"
    else
        printf 'Error: model not found: %s\n' "$model" >&2; return 1
    fi
}

_lls_wait_http() {
    local url="$1" label="$2" timeout="${3:-60}" logfile="${4:-}"
    # Patterns that indicate a terminal load failure — abort early when seen,
    # rather than waiting the full timeout for /health to never come.
    local err_re='out of memory|cudaMalloc failed|unable to load model|failed to (allocate|load|create context)|llama_kv_cache_init: failed|error: failed|GGML_ASSERT|terminate called|panic:'
    local i http_code
    for i in $(seq 1 "$timeout"); do
        http_code=$(curl -so /dev/null --max-time 2 -w "%{http_code}" "$url" 2>/dev/null)
        [[ "$http_code" == "200" ]] && { printf '\r%s ready.%-30s\n' "$label" ""; return 0; }
        [[ "$http_code" == "503" ]] && printf '\r  loading model... %ds' "$i"
        # Cheap log probe: scan only the tail so cost stays O(1) per tick.
        if [[ -n "$logfile" && -r "$logfile" ]]; then
            if tail -n 200 "$logfile" 2>/dev/null | grep -qiE -- "$err_re"; then
                printf '\n%s failed to start — log says:\n' "$label" >&2
                tail -n 200 "$logfile" 2>/dev/null \
                    | grep -iE -- "$err_re" \
                    | tail -n 8 \
                    | sed 's/^/  /' >&2
                printf '  (full log: %s)\n' "$logfile" >&2
                return 1
            fi
        fi
        sleep 1
    done
    printf '\nTimeout after %ds waiting for %s\n' "$timeout" "$label" >&2
    if [[ -n "$logfile" && -r "$logfile" ]]; then
        printf 'Last 20 lines of %s:\n' "$logfile" >&2
        tail -n 20 "$logfile" 2>/dev/null | sed 's/^/  /' >&2
    fi
    return 1
}

