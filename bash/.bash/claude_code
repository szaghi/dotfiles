    printf '  %-36s%s\n' 'claude-local --backend llama'    'use llama-server instead'
    printf '  %-36s%s\n' 'claude-local --backend ikllama'  'use ik_llama.cpp fork (faster MoE/CPU-hybrid;'
    printf '  %-36s%s\n' ''                                '  worse on dense+SWA at tight VRAM, e.g. Gemma)'
    printf '  %-36s%s\n' 'claude-local --model NAME'       'override model'
    printf '  %-36s%s\n' 'claude-local --ctx 128k'         'override context (llama/ikllama only; Ollama: use ollama-create)'
    printf '  %-36s%s\n' 'claude-local --gpus 1'           'Ollama: single GPU (HPC-safe)'
    printf '  %-36s%s\n' 'claude-local --no-autostart'     'skip server start (must be running)'
    printf '  %-36s%s\n' 'claude-local --no-autostop'      'keep server running after exit'
    printf '  %-36s%s\n' 'claude-local -- [CLAUDE_ARGS]'   'pass args directly to claude'

    printf '\n'
    printf "  ${b}LLM-LOCAL-SERVER${r}  service management\n"
    printf '%s\n' "$sep"
    printf '  %-52s%s\n' 'llm-local-server start'                              'start default backend'
    printf '  %-52s%s\n' 'llm-local-server start --backend llama --ctx 128k'   'llama-server with ctx'
    printf '  %-52s%s\n' 'llm-local-server start --backend ikllama --ctx 128k' 'ik_llama-server with ctx'
    printf '  %-52s%s\n' 'llm-local-server stop'                               'stop default backend'
    printf '  %-52s%s\n' 'llm-local-server stop --backend ollama|llama|ikllama' 'stop specific backend'
    printf '  %-52s%s\n' 'llm-local-server restart [opts]'                     'stop + start'
    printf '  %-52s%s\n' 'llm-local-server status'                             'all backends + GPU'
    printf '  %-52s%s\n' 'llm-local-server status --backend ikllama'           'narrow to one backend'

    printf '\n'
    printf "  ${b}OLLAMA UTILITIES${r}\n"
    printf '%s\n' "$sep"
    printf '  %-36s%s\n' 'ollama-pull [model]'             'pull a model'
    printf '  %-36s%s\n' 'ollama-create [--ctx N] [model]' 'create context-capped variant'
    printf '  %-36s%s\n' 'ollama-models'                   'list models grouped by suffix (cloud/embedding/plan/exec/misc)'
    printf '  %-36s%s\n' 'ollama-rename <old> <new>'       'rename model (exact casing)'
    printf '  %-36s%s\n' 'ollama-rm <model> [model ...]'   'remove model(s); confirms when >1'

    printf '\n'
    printf "  ${b}LLAMA.CPP / IK_LLAMA.CPP UTILITIES${r}  (shared — both backends read \$LLAMACPP_MODELS_DIR)\n"
    printf '%s\n' "$sep"
    printf '  %-36s%s\n' 'llama-models'                    'grouped list (basename + quants) of GGUFs in models dir + HF cache'
    printf '  %-36s%s\n' 'llama-models --paths'            'one full path per line (pipe to grep / llama-alias)'
    printf '  %-36s%s\n' 'llama-models --raw'              'TSV: location/file/size/path/link'
    printf '  %-36s%s\n' 'llama-alias <name> <path>'       'alias to explicit GGUF path (symlink)'
    printf '  %-36s%s\n' 'llama-alias <name> <substr>...'  'alias to fuzzy match (all substrs must match)'
    printf '  %-36s%s\n' 'llama-alias <name>'              'remove alias'
    printf '  %-36s%s\n' 'llama-rm <substr>... | <path>'   'delete GGUF (models dir → file; HF cache → whole repo)'
    printf '  %-36s%s\n' 'llama-info [model]'              'GGUF metadata + tensor summary'

    printf '\n'
    printf "  ${b}HUGGINGFACE UTILITIES${r}  (requires hf CLI from huggingface_hub >= 0.34)\n"
    printf '%s\n' "$sep"
    printf '  %-36s%s\n' 'hf-search <query> [--all]'       'search HF (GGUF-filtered by default)'
    printf '  %-36s%s\n' 'hf-files <repo> [--all]'         'list files in a repo (GGUFs first)'
    printf '  %-36s%s\n' 'hf-pick <repo>'                  'interactive: pick a GGUF and pull it'
    printf '  %-36s%s\n' 'hf-pull <repo> [file ...]'       'download into LLAMACPP_MODELS_DIR'
    printf '  %-36s%s\n' 'hf-test <repo> [file]'           'pull → alias → smoke-test on ikllama'

    printf '\n'
    printf "  ${b}ENV OVERRIDES${r}\n"
    printf '%s\n' "$sep"
    printf '  %-36s%s\n' 'LOCAL_DEFAULT_BACKEND'           'ollama|llama|ikllama  (default: ollama)'
    printf '  %-36s%s\n' 'OLLAMA_DEFAULT_MODEL'            'default Ollama model'
    printf '  %-36s%s\n' 'LLAMACPP_DEFAULT_MODEL'          'default GGUF path/alias'
    printf '  %-36s%s\n' 'LLAMACPP_CTX'                    'default context size (default: 131072)'
    printf '  %-36s%s\n' 'LLAMACPP_GPU_LAYERS'             'GPU layers (-1 = all, default: -1)'
    printf '  %-36s%s\n' 'LLAMACPP_BIN'                    'llama-server binary path'
    printf '  %-36s%s\n' 'LLAMACPP_PORT'                   'llama-server port (default: 8080)'
    printf '  %-36s%s\n' 'IKLLAMA_BIN'                     'ik_llama.cpp server binary path'
    printf '  %-36s%s\n' 'IKLLAMA_PORT'                    'ik_llama.cpp port (default: 8081)'
    printf '  %-36s%s\n' 'IKLLAMA_DEFAULT_MODEL'           'default GGUF (falls back to LLAMACPP_*)'
    printf '  %-36s%s\n' 'IKLLAMA_CTX'                     'default context (default: 131072)'
    printf '  %-36s%s\n' 'IKLLAMA_GPU_LAYERS'              'GPU layers (-1 = all, default: -1)'
    printf '\n'
}

# ── MACHINE-SPECIFIC OVERRIDES ────────────────────────────────────────────────
# Deployed by the machine's own stow package (e.g. bash-adam, bash-quark).
# Overrides: GPU IDs, model defaults, LLAMACPP_BIN, CUDA lib paths, etc.
[[ -f "${HOME}/.bash/claude_code.local" ]] && source "${HOME}/.bash/claude_code.local"
