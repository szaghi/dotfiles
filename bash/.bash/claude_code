#!/usr/bin/env bash
# Claude Code: Cloud + Local inference setup
# Machine-specific overrides (GPU IDs, model paths, binary locations) live in
# ~/.bash/claude_code.local — deployed by the machine's own stow package.
# Source from ~/.bashrc or ~/.zshrc

# ── OLLAMA SETTINGS ───────────────────────────────────────────────────────────
export OLLAMA_HOST="127.0.0.1:11434"
export OLLAMA_KEEP_ALIVE="10m"
export OLLAMA_NUM_PARALLEL="1"
export OLLAMA_MAX_LOADED_MODELS="1"

# ── OLLAMA MODEL DEFAULTS (override in claude_code.local) ─────────────────────
OLLAMA_DEFAULT_MODEL="qwen2.5-coder:7b"

# ── LLAMA.CPP SETTINGS (override in claude_code.local) ───────────────────────
LLAMACPP_BIN="${LLAMACPP_BIN:-llama-server}"
LLAMACPP_HOST="127.0.0.1"
LLAMACPP_PORT="${LLAMACPP_PORT:-8080}"
LLAMACPP_MODELS_DIR="${LLAMACPP_MODELS_DIR:-${HOME}/models}"
LLAMACPP_DEFAULT_MODEL="${LLAMACPP_DEFAULT_MODEL:-}"
LLAMACPP_GPU_LAYERS="${LLAMACPP_GPU_LAYERS:--1}"
LLAMACPP_CTX="${LLAMACPP_CTX:-131072}"

# ── IK_LLAMA.CPP SETTINGS (override in claude_code.local) ────────────────────
# ik_llama.cpp is a llama.cpp fork with aggressive CPU/hybrid optimizations
# and new quant types (IQ4_KS, IQ2_KS). CLI is compatible with mainline.
# Runs on a distinct port (8081) so both servers can coexist if needed.
#
# Where it WINS: MoE models that spill to RAM, CPU/hybrid inference.
# Where it LOSES: dense models with sliding-window attention (Gemma 3/4) at
# tight VRAM — mainline llama.cpp has iSWA KV-cache + auto layer-fit across
# GPUs that ik_llama lacks, so the same GGUF can fit on mainline and OOM on
# ik_llama. For Gemma-class models on 2×12GB, prefer the llama backend.
IKLLAMA_BIN="${IKLLAMA_BIN:-llama-server}"
IKLLAMA_HOST="127.0.0.1"
IKLLAMA_PORT="${IKLLAMA_PORT:-8081}"
IKLLAMA_GPU_LAYERS="${IKLLAMA_GPU_LAYERS:-99}"  # ik_llama.cpp parses -1 as 0 layers; use a large sentinel
IKLLAMA_CTX="${IKLLAMA_CTX:-131072}"
# IKLLAMA_MODELS_DIR and IKLLAMA_DEFAULT_MODEL fall back to LLAMACPP_* lazily
# at call time (see _lls_start_llama_generic) so overrides set in claude_code.local
# after this file are picked up correctly.

# ── LOCAL BACKEND DEFAULT (override in claude_code.local) ─────────────────────
LOCAL_DEFAULT_BACKEND="${LOCAL_DEFAULT_BACKEND:-ollama}"

# ── CLOUD FUNCTIONS ───────────────────────────────────────────────────────────

claude-sonnet() { claude --model "sonnet" "$@"; }
claude-opus()   { claude --model "opus"   "$@"; }
claude-plan()   { claude --permission-mode plan --model "opusplan" "$@"; }

OPENROUTER_DEFAULT_MODEL="qwen/qwen3.6-plus-preview:free"

claude-openrouter() {
    local model="${1:-$OPENROUTER_DEFAULT_MODEL}"
    local key="${OPENROUTER_API_KEY:-$(cat "$HOME/.openrouter-ai-key" 2>/dev/null)}"
    if [[ -z "$key" ]]; then
        printf 'Error: no OpenRouter API key (set OPENROUTER_API_KEY or ~/.openrouter-ai-key)\n' >&2
        return 1
    fi
    ANTHROPIC_AUTH_TOKEN="$key" \
    ANTHROPIC_BASE_URL="https://openrouter.ai/api" \
    ANTHROPIC_API_KEY="" \
    claude --model "$model" "${@:2}"
}

ZAI_DEFAULT_MODEL="glm-5-turbo"

claude-zai() {
    local model="${1:-$ZAI_DEFAULT_MODEL}"
    local key="${ZAI_API_KEY:-$(cat "$HOME/.z-ai-key" 2>/dev/null)}"
    if [[ -z "$key" ]]; then
        printf 'Error: no Z.ai API key (set ZAI_API_KEY or ~/.z-ai-key)\n' >&2
        return 1
    fi
    ANTHROPIC_AUTH_TOKEN="$key" \
    ANTHROPIC_BASE_URL="https://api.z.ai/api/anthropic" \
    ANTHROPIC_API_KEY="" \
    claude --model "$model" "${@:2}"
}

claude-zai-fast()    { claude-zai "glm-4.5-air" "$@"; }
claude-zai-turbo()   { claude-zai "glm-5-turbo" "$@"; }
claude-zai-premium() { claude-zai "glm-5.1"     "$@"; }

# ── CNR IAC INSTITUTE ACCOUNT ─────────────────────────────────────────────────
# Second Claude Code account (CNR IAC Pro plan, bound to the institute email),
# kept fully isolated from the personal account via a separate CLAUDE_CONFIG_DIR.
# Credentials, login state (~/.claude.json) and per-project trust live under
# ~/.claude-iac and never collide with ~/.claude. Account-agnostic config
# (CLAUDE.md, slash commands, skills, settings) is symlinked in so the institute
# account inherits the same instructions and tooling.
#
# First use:  claude-iac login   → authenticate the isolated config (see below).
# Thereafter: claude-iac         → institute-account session
#             claude-iac status  → show which account the isolated config is on
#             claude / claude-{sonnet,opus,plan} → personal account, unchanged.
#
# Login note: the OAuth page reuses whatever Claude session your BROWSER already
# holds, so a plain login silently grabs the personal account. `claude-iac login`
# pre-populates the institute email (--email) and forces the SSO flow (--sso),
# which is how institutional plans bind accounts. Still open the printed URL in an
# INCOGNITO window or a browser profile not signed into your personal claude.ai.
# Set the email in claude_code.local:  CLAUDE_IAC_EMAIL="you@cnr.it"
CLAUDE_IAC_DIR="${CLAUDE_IAC_DIR:-${HOME}/.claude-iac}"
CLAUDE_IAC_EMAIL="${CLAUDE_IAC_EMAIL:-}"

claude-iac() {
    _claude_iac_bootstrap || return 1
    case "${1:-}" in
        login)
            local -a a=()
            [[ -n "$CLAUDE_IAC_EMAIL" ]] && a+=(--email "$CLAUDE_IAC_EMAIL")
            # --sso is the usual path for institute-bound accounts; if IAC issued a
            # plain subscription instead, re-run with:  claude-iac login --no-sso
            if [[ "${2:-}" == "--no-sso" ]]; then shift; else a+=(--sso); fi
            printf 'Authenticating CNR IAC account in %s\n' "$CLAUDE_IAC_DIR" >&2
            [[ -z "$CLAUDE_IAC_EMAIL" ]] && printf 'Tip: set CLAUDE_IAC_EMAIL in ~/.bash/claude_code.local to pre-fill the email.\n' >&2
            printf 'Open the URL below in an INCOGNITO window (not signed into personal claude.ai).\n' >&2
            CLAUDE_CONFIG_DIR="$CLAUDE_IAC_DIR" claude auth login "${a[@]}" "${@:2}"
            ;;
        status)
            CLAUDE_CONFIG_DIR="$CLAUDE_IAC_DIR" claude auth status --text "${@:2}"
            ;;
        logout)
            CLAUDE_CONFIG_DIR="$CLAUDE_IAC_DIR" claude auth logout "${@:2}"
            ;;
        *)
            CLAUDE_CONFIG_DIR="$CLAUDE_IAC_DIR" claude "$@"
            ;;
    esac
}

# Idempotent: create the isolated config dir and symlink the shareable parts.
# Re-running is harmless (ln -sfn refreshes links; missing sources are skipped).
_claude_iac_bootstrap() {
    local src="${HOME}/.claude" dst="$CLAUDE_IAC_DIR" item
    mkdir -p "$dst" || return 1
    # Account-agnostic, safe to share. NOT shared: .credentials.json, .claude.json,
    # settings.local.json — these carry auth/login/per-machine state.
    for item in CLAUDE.md CLAUDE-fortran.md CLAUDE-gpu.md commands skills settings.json; do
        [[ -e "${src}/${item}" ]] && ln -sfn "${src}/${item}" "${dst}/${item}"
    done
    return 0
}

# ── LOCAL INFERENCE ENTRY POINT ───────────────────────────────────────────────
#
# claude-local [OPTIONS] [-- CLAUDE_ARGS...]
#
#   --backend ollama|llama   inference engine  (default: $LOCAL_DEFAULT_BACKEND)
#   --model   NAME           model name or GGUF path/alias
#   --ctx     TOKENS|32k|64k|128k   context window (default: per-backend default)
#   --gpus    1|2|all        GPU count for Ollama (default: all)
#   --no-autostart           do not start the server if not running
#   --no-autostop            do not stop the server when Claude exits
#
# By default claude-local auto-starts the correct backend before launching Claude
# and auto-stops it after Claude exits. If a different backend is already running
# it is stopped first.

claude-local() {
    local backend="$LOCAL_DEFAULT_BACKEND"
    local model="" ctx="" gpus="all"
    local autostart=1 autostop=1
    local -a claude_args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --backend)        backend="$2";    shift 2 ;;
            --model)          model="$2";      shift 2 ;;
            --ctx)            ctx="$2";        shift 2 ;;
            --gpus)           gpus="$2";       shift 2 ;;
            --no-autostart)   autostart=0;     shift   ;;
            --no-autostop)    autostop=0;      shift   ;;
            --)               shift; claude_args+=("$@"); break ;;
            *)                claude_args+=("$1"); shift ;;
        esac
    done

    # Validate backend
    case "$backend" in
        ollama|llama|ikllama) ;;
        *) printf 'Error: unknown backend "%s" (ollama|llama|ikllama)\n' "$backend" >&2; return 1 ;;
    esac

    if (( autostart )); then
        _local_autostart "$backend" "$model" "$ctx" "$gpus" || return 1
    fi

    local n_gpus
    case "$gpus" in
        all|2|"") n_gpus=2 ;;
        *)        n_gpus="$gpus" ;;
    esac

    local rc=0
    case "$backend" in
        ollama)
            local m="${model:-$OLLAMA_DEFAULT_MODEL}"
            ANTHROPIC_BASE_URL="http://${OLLAMA_HOST}" \
            CLAUDE_LOCAL_GPUS="$n_gpus" \
            claude --model "$m" "${claude_args[@]}"
            rc=$?
            ;;
        llama)
            if ! curl -sf --max-time 2 "http://${LLAMACPP_HOST}:${LLAMACPP_PORT}/health" &>/dev/null; then
                printf 'llama-server not reachable at %s:%s\n' "$LLAMACPP_HOST" "$LLAMACPP_PORT" >&2
                return 1
            fi
            local m="${model:-llama}"
            ANTHROPIC_BASE_URL="http://${LLAMACPP_HOST}:${LLAMACPP_PORT}" \
            CLAUDE_LOCAL_GPUS="$n_gpus" \
            claude --model "$m" "${claude_args[@]}"
            rc=$?
            ;;
        ikllama)
            if ! curl -sf --max-time 2 "http://${IKLLAMA_HOST}:${IKLLAMA_PORT}/health" &>/dev/null; then
                printf 'ik_llama-server not reachable at %s:%s\n' "$IKLLAMA_HOST" "$IKLLAMA_PORT" >&2
                return 1
            fi
            local m="${model:-ikllama}"
            ANTHROPIC_BASE_URL="http://${IKLLAMA_HOST}:${IKLLAMA_PORT}" \
            CLAUDE_LOCAL_GPUS="$n_gpus" \
            claude --model "$m" "${claude_args[@]}"
            rc=$?
            ;;
    esac

    if (( autostop )); then
        llm-local-server stop --backend "$backend"
    fi

    return $rc
}

# Internal: ensure the right backend is up, stopping the others if needed.
_local_autostart() {
    local backend="$1" model="$2" ctx="$3" gpus="$4"

    local ollama_up=0 llama_up=0 ikllama_up=0
    curl -sf --max-time 2 "http://${OLLAMA_HOST}/api/tags"                  &>/dev/null && ollama_up=1
    curl -sf --max-time 2 "http://${LLAMACPP_HOST}:${LLAMACPP_PORT}/health" &>/dev/null && llama_up=1
    curl -sf --max-time 2 "http://${IKLLAMA_HOST}:${IKLLAMA_PORT}/health"   &>/dev/null && ikllama_up=1

    _stop_other() {
        local self="$1"
        if [[ "$self" != "ollama"  ]] && (( ollama_up  )); then
            printf 'Ollama is running — stopping it\n'
            llm-local-server stop --backend ollama
        fi
        if [[ "$self" != "llama"   ]] && (( llama_up   )); then
            printf 'llama-server is running — stopping it\n'
            llm-local-server stop --backend llama
        fi
        if [[ "$self" != "ikllama" ]] && (( ikllama_up )); then
            printf 'ik_llama-server is running — stopping it\n'
            llm-local-server stop --backend ikllama
        fi
    }

    case "$backend" in
        ollama)
            _stop_other ollama
            if (( ! ollama_up )); then
                llm-local-server start --backend ollama --gpus "$gpus" \
                    ${model:+--model "$model"} || return 1
            fi
            ;;
        llama)
            _stop_other llama
            if (( ! llama_up )); then
                llm-local-server start --backend llama \
                    ${model:+--model "$model"} ${ctx:+--ctx "$ctx"} || return 1
            fi
            ;;
        ikllama)
            _stop_other ikllama
            if (( ! ikllama_up )); then
                llm-local-server start --backend ikllama \
                    ${model:+--model "$model"} ${ctx:+--ctx "$ctx"} || return 1
            fi
            ;;
    esac
}

# ── LLM LOCAL SERVER ──────────────────────────────────────────────────────────
#
# llm-local-server COMMAND [OPTIONS]
#
# Commands: start | stop | restart | status
#
# start options:
#   --backend ollama|llama   (default: $LOCAL_DEFAULT_BACKEND)
#   --model   NAME|PATH      model name (ollama) or GGUF path/alias (llama)
#   --ctx     TOKENS|32k|64k|128k
#   --gpus    1|2|all        Ollama only — GPU count (default: all)
#   [extra...]               passed through to the backend binary
#
# stop/restart/status options:
#   --backend ollama|llama   (default: $LOCAL_DEFAULT_BACKEND)

llm-local-server() {
    local cmd="${1:-}"; shift || true
    case "$cmd" in
        start)   _lls_start   "$@" ;;
        stop)    _lls_stop    "$@" ;;
        restart) _lls_restart "$@" ;;
        status)  _lls_status  "$@" ;;
        *)
            printf 'Usage: llm-local-server start|stop|restart|status [--backend ollama|llama] [options]\n' >&2
            return 1
            ;;
    esac
}

_lls_parse_backend() {
    # Writes into caller's $backend and $extra_args locals.
    # backend defaults to LOCAL_DEFAULT_BACKEND if not set by caller.
    [[ -z "${backend:-}" ]] && backend="$LOCAL_DEFAULT_BACKEND"
    extra_args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --backend) backend="$2"; shift 2 ;;
            *)         extra_args+=("$1"); shift ;;
        esac
    done
}

_lls_start() {
    local backend model="" ctx="" gpus="all"
    local -a extra_args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --backend) backend="$2"; shift 2 ;;
            --model)   model="$2";   shift 2 ;;
            --ctx)     ctx="$2";     shift 2 ;;
            --gpus)    gpus="$2";    shift 2 ;;
            --)        shift; extra_args+=("$@"); break ;;
            *)         extra_args+=("$1"); shift ;;
        esac
    done
    backend="${backend:-$LOCAL_DEFAULT_BACKEND}"

    case "$backend" in
        ollama)  _lls_start_ollama  "$model" "$gpus" "${extra_args[@]}" ;;
        llama)   _lls_start_llama   "$model" "$ctx"  "${extra_args[@]}" ;;
        ikllama) _lls_start_ikllama "$model" "$ctx"  "${extra_args[@]}" ;;
        *) printf 'Error: unknown backend "%s"\n' "$backend" >&2; return 1 ;;
    esac
}

_lls_start_ollama() {
    local model="$1" gpus="$2"; shift 2
    local -a extra_args=("$@")

    if curl -sf --max-time 2 "http://${OLLAMA_HOST}/api/tags" &>/dev/null; then
        printf 'Ollama already running at http://%s\n' "$OLLAMA_HOST"
        return 0
    fi

    printf 'Starting Ollama'
    case "$gpus" in
        all|2|"")
            printf ' on all GPUs\n'
            ollama serve "${extra_args[@]}" &>/tmp/ollama.log &
            ;;
        1)
            local gpu="${OLLAMA_GPU_UUID:-${OLLAMA_GPU_ID:-0}}"
            printf ' on GPU %s\n' "$gpu"
            CUDA_VISIBLE_DEVICES="$gpu" ollama serve "${extra_args[@]}" &>/tmp/ollama.log &
            ;;
        *)
            printf ' on GPU(s) %s\n' "$gpus"
            CUDA_VISIBLE_DEVICES="$gpus" ollama serve "${extra_args[@]}" &>/tmp/ollama.log &
            ;;
    esac
    disown

    _lls_wait_http "http://${OLLAMA_HOST}/api/tags" "Ollama" 60 "/tmp/ollama.log" || return 1

}

_lls_start_llama()   { _lls_start_llama_generic "llama"   "$@"; }
_lls_start_ikllama() { _lls_start_llama_generic "ikllama" "$@"; }

# Generic llama.cpp-family server starter. Drives both mainline llama.cpp and
# ik_llama.cpp (CLI-compatible fork). Flavor picks the env-var prefix:
#   llama   → LLAMACPP_BIN / LLAMACPP_HOST / LLAMACPP_PORT / ...
#   ikllama → IKLLAMA_BIN  / IKLLAMA_HOST  / IKLLAMA_PORT  / ...
_lls_start_llama_generic() {
    local flavor="$1" model_arg="$2" ctx="$3"; shift 3
    local -a extra_args=("$@")

    local bin host port gpu_layers default_ctx models_dir default_model label logfile
    case "$flavor" in
        llama)
            bin="$LLAMACPP_BIN"        host="$LLAMACPP_HOST"    port="$LLAMACPP_PORT"
            gpu_layers="$LLAMACPP_GPU_LAYERS"   default_ctx="$LLAMACPP_CTX"
            models_dir="$LLAMACPP_MODELS_DIR"   default_model="$LLAMACPP_DEFAULT_MODEL"
            label="llama-server"                logfile="/tmp/llama-server.log"
            ;;
        ikllama)
            bin="$IKLLAMA_BIN"         host="$IKLLAMA_HOST"     port="$IKLLAMA_PORT"
            gpu_layers="$IKLLAMA_GPU_LAYERS"    default_ctx="$IKLLAMA_CTX"
            models_dir="${IKLLAMA_MODELS_DIR:-$LLAMACPP_MODELS_DIR}"
            default_model="${IKLLAMA_DEFAULT_MODEL:-$LLAMACPP_DEFAULT_MODEL}"
            label="ik_llama-server"             logfile="/tmp/ikllama-server.log"
            ;;
        *) printf 'Error: unknown flavor "%s"\n' "$flavor" >&2; return 1 ;;
    esac

    if curl -sf --max-time 2 "http://${host}:${port}/health" &>/dev/null; then
        printf '%s already running at %s:%s\n' "$label" "$host" "$port"
        return 0
    fi

    if ! command -v "$bin" &>/dev/null && [[ ! -x "$bin" ]]; then
        printf 'Error: %s binary not found (tried: %s)\n' "$label" "$bin" >&2
        printf 'Set %s_BIN=/full/path/to/llama-server in claude_code.local\n' \
            "$(printf '%s' "$flavor" | tr '[:lower:]' '[:upper:]' | sed 's/ikllama/IKLLAMA/;s/llama/LLAMACPP/')" >&2
        return 1
    fi

    # No --model passed and we're on a TTY → pick interactively. The default
    # (if any) is shown as the Enter-to-accept choice.
    if [[ -z "$model_arg" ]] && [[ -t 0 && -t 1 ]]; then
        model_arg=$(_llama_pick_model "$models_dir" "$default_model") || return 1
    fi

    local model_path
    model_path=$(_llama_resolve_model_in "$model_arg" "$models_dir" "$default_model") || return 1

    local resolved_ctx
    resolved_ctx=$(_parse_ctx "${ctx:-$default_ctx}")

    printf 'Starting %s\n' "$label"
    printf '  model : %s\n' "$model_path"
    printf '  addr  : %s:%s\n' "$host" "$port"
    printf '  gpu   : %s layers  ctx: %s\n' "$gpu_layers" "$resolved_ctx"

    "$bin" \
        --model        "$model_path" \
        --alias        "$flavor" \
        --host         "$host" \
        --port         "$port" \
        --n-gpu-layers "$gpu_layers" \
        --ctx-size     "$resolved_ctx" \
        --flash-attn on \
        --jinja \
        "${extra_args[@]}" &>"$logfile" &
    disown

    _lls_wait_http "http://${host}:${port}/health" "$label" 120 "$logfile"
}

_lls_stop() {
    local backend extra_args=()
    _lls_parse_backend "$@"

    case "$backend" in
        ollama)
            pkill -f "ollama serve" 2>/dev/null \
                && printf 'Ollama stopped.\n' \
                || printf 'Ollama not running.\n'
            ;;
        llama)   _lls_stop_llama_generic "llama"   "$LLAMACPP_PORT" ;;
        ikllama) _lls_stop_llama_generic "ikllama" "$IKLLAMA_PORT"  ;;
        *) printf 'Error: unknown backend "%s"\n' "$backend" >&2; return 1 ;;
    esac
}

# Both llama.cpp and ik_llama.cpp ship a binary called "llama-server" — we
# distinguish them by the --alias flag (llama vs ikllama) set at start, so
# pkill targets the exact process even when both are running.
_lls_stop_llama_generic() {
    local flavor="$1" port="$2"
    local label
    [[ "$flavor" == "ikllama" ]] && label="ik_llama-server" || label="llama-server"

    pkill -f "llama-server .*--alias ${flavor}( |$)" 2>/dev/null \
        || { printf '%s not running.\n' "$label"; return 0; }

    local i
    for i in 1 2 3 4 5; do
        ss -tlnp 2>/dev/null | grep -q ":${port}" || {
            printf '%s stopped.\n' "$label"; return 0
        }
        sleep 1
    done
    printf '%s stopped (port %s may still be in TIME_WAIT).\n' "$label" "$port"
}

_lls_status_llama_generic() {
    local flavor="$1" host="$2" port="$3" label="$4"
    printf '=== %s process ===\n' "$label"
    pgrep -af "llama-server .*--alias ${flavor}( |$)" || printf 'Not running\n'
    printf '\n=== Served model ===\n'
    local models_json
    if models_json=$(curl -sf --max-time 2 "http://${host}:${port}/v1/models" 2>/dev/null) \
            && [[ -n "$models_json" ]]; then
        printf '%s\n' "$models_json" | python3 -m json.tool 2>/dev/null \
            || printf '%s\n' "$models_json"
    else
        printf 'Cannot reach %s at %s:%s\n' "$label" "$host" "$port"
    fi
}

_lls_restart() {
    local backend extra_args=()
    _lls_parse_backend "$@"
    _lls_stop --backend "$backend"
    sleep 1
    _lls_start --backend "$backend" "${extra_args[@]}"
}

_lls_status() {
    # If --backend is passed, narrow to that one; otherwise report all three.
    local explicit_backend="" arg
    for arg in "$@"; do [[ "$arg" == "--backend" ]] && explicit_backend=1; done

    if [[ -n "$explicit_backend" ]]; then
        local backend extra_args=()
        _lls_parse_backend "$@"
        _lls_status_one "$backend" || return 1
    else
        _lls_status_one ollama
        printf '\n'
        _lls_status_one llama
        printf '\n'
        _lls_status_one ikllama
    fi

    printf '\n=== GPU status ===\n'
    nvidia-smi --query-gpu=index,name,memory.used,memory.total,utilization.gpu \
               --format=csv,noheader,nounits 2>/dev/null || printf 'nvidia-smi not available\n'
}

_lls_status_one() {
    local backend="$1"
    case "$backend" in
        ollama)
            printf '=== Ollama process ===\n'
            pgrep -a "ollama" || printf 'Not running\n'
            printf '\n=== Loaded models ===\n'
            local ps_json
            if ps_json=$(curl -sf --max-time 2 "http://${OLLAMA_HOST}/api/ps" 2>/dev/null) \
                    && [[ -n "$ps_json" ]]; then
                printf '%s\n' "$ps_json" | python3 -m json.tool 2>/dev/null \
                    || printf '%s\n' "$ps_json"
            else
                printf 'Cannot reach Ollama at http://%s\n' "$OLLAMA_HOST"
            fi
            ;;
        llama)   _lls_status_llama_generic "llama"   "$LLAMACPP_HOST" "$LLAMACPP_PORT" "llama-server"    ;;
        ikllama) _lls_status_llama_generic "ikllama" "$IKLLAMA_HOST"  "$IKLLAMA_PORT"  "ik_llama-server" ;;
        *) printf 'Error: unknown backend "%s"\n' "$backend" >&2; return 1 ;;
    esac
}

# ── OLLAMA MODEL UTILITIES ────────────────────────────────────────────────────

ollama-pull() {
    local model="${1:-$OLLAMA_DEFAULT_MODEL}"
    printf 'Pulling: %s\n' "$model"
    ollama pull "$model"
}

ollama-create() {
    # Create a context-capped variant: ollama-create [--ctx 32k|64k|128k|N] [model]
    local ctx=65536 model=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ctx) ctx=$(_parse_ctx "$2"); shift 2 ;;
            *)     model="$1"; shift ;;
        esac
    done
    model="${model:-$OLLAMA_DEFAULT_MODEL}"
    local label
    if   (( ctx <= 32768  )); then label="32k"
    elif (( ctx <= 65536  )); then label="64k"
    elif (( ctx <= 131072 )); then label="128k"
    else                           label="${ctx}"
    fi
    local variant="${model}-${label}"
    local tmpfile
    tmpfile=$(mktemp /tmp/Modelfile.XXXXXX)
    printf 'FROM %s\nPARAMETER num_ctx %s\n' "$model" "$ctx" > "$tmpfile"
    ollama create "$variant" -f "$tmpfile"
    rm -f "$tmpfile"
    printf 'Created: %s  (use with: claude-local --model %s)\n' "$variant" "$variant"
}

ollama-models() {
    local output
    output=$(ollama list 2>/dev/null) || { printf 'Ollama not running.\n' >&2; return 1; }
    local header lines
    header=$(printf '%s\n' "$output" | head -1)
    lines=$(printf '%s\n' "$output" | tail -n +2)
    [[ -z "$lines" ]] && { printf '%s\n' "$header"; printf '(no models)\n'; return 0; }
    printf '%s\n' "$header"
    local cat matched
    for cat in cloud embedding plan exec; do
        matched=$(printf '%s\n' "$lines" | awk -v c="$cat" '$1 ~ "[-:]"c"$"')
        [[ -n "$matched" ]] && printf '\n  [%s]\n%s\n' "$cat" "$matched"
    done
    matched=$(printf '%s\n' "$lines" | awk '$1 !~ "[-:](cloud|embedding|plan|exec)$"')
    [[ -n "$matched" ]] && printf '\n  [misc]\n%s\n' "$matched"
}

ollama-rm() {
    # Remove one or more Ollama models. Asks for confirmation when >1 model
    # is targeted, since `ollama rm` has no built-in safety.
    if [[ $# -eq 0 ]]; then
        printf 'Usage: ollama-rm <model> [model ...]\n' >&2; return 1
    fi
    local m missing=()
    for m in "$@"; do
        ollama show "$m" &>/dev/null || missing+=("$m")
    done
    if (( ${#missing[@]} )); then
        printf "Error: model(s) not found: %s\n" "${missing[*]}" >&2
        printf 'Available:\n' >&2
        ollama list >&2
        return 1
    fi
    if (( $# > 1 )); then
        printf 'About to remove %d models:\n' "$#"
        printf '  %s\n' "$@"
        local reply
        read -r -p 'Proceed? [y/N] ' reply
        [[ "$reply" =~ ^[Yy]$ ]] || { printf 'Aborted.\n'; return 1; }
    fi
    local rc=0
    for m in "$@"; do
        ollama rm "$m" || rc=$?
    done
    return $rc
}

ollama-rename() {
    # Rename an Ollama model, bypassing the ollama cp inheritance quirk.
    if [[ $# -ne 2 ]]; then
        printf 'Usage: ollama-rename <old-name> <new-name>\n' >&2; return 1
    fi
    local old="$1" new="$2" tmpfile
    tmpfile=$(mktemp /tmp/Modelfile.XXXXXX)
    if ! ollama show "$old" --modelfile > "$tmpfile" 2>/dev/null && \
       ! ollama show --modelfile "$old"  > "$tmpfile" 2>/dev/null; then
        printf "Error: model '%s' not found\n" "$old" >&2
        ollama list >&2; rm -f "$tmpfile"; return 1
    fi
    if ollama create "$new" -f "$tmpfile"; then
        ollama rm "$old"
    else
        printf "Error: failed to create '%s' — '%s' was not removed.\n" "$new" "$old" >&2
        rm -f "$tmpfile"; return 1
    fi
    rm -f "$tmpfile"
}

# ── LLAMA.CPP MODEL UTILITIES ─────────────────────────────────────────────────

llama-models() {
    local mode="grouped"
    case "${1:-}" in
        --paths) mode="paths"; shift ;;
        --raw)   mode="raw";   shift ;;
        -h|--help)
            printf 'Usage: llama-models [--paths|--raw]\n' >&2
            printf '  default   grouped by model basename, sorted by quant precision\n' >&2
            printf '  --paths   one full path per line (use with grep / xargs / llama-alias)\n' >&2
            printf '  --raw     TSV: location\\tfilename\\tsize\\tfullpath\\tlinktarget\n' >&2
            return 0 ;;
    esac

    local hf_cache="${HF_HOME:-${HOME}/.cache/huggingface}/hub"
    local found=0

    # Build a TSV stream: location<TAB>filename<TAB>size_bytes<TAB>fullpath<TAB>linktarget
    # Then group/sort with one awk pass for both locations.
    local stream
    stream=$(
        if [[ -d "$LLAMACPP_MODELS_DIR" ]]; then
            find "$LLAMACPP_MODELS_DIR" -maxdepth 2 -name "*.gguf" 2>/dev/null \
                | while IFS= read -r f; do
                    local name="${f##*/}" link=""
                    [[ -L "$f" ]] && link=$(readlink -f "$f")
                    printf 'models\t%s\t%s\t%s\t%s\n' "$name" "$(stat -L -c %s "$f" 2>/dev/null)" "$f" "$link"
                done
        fi
        if [[ -d "$hf_cache" ]]; then
            # Build a set of resolved alias targets so we can dedup cache entries
            # that already appear as aliases. Using an assoc array avoids the
            # bash 5.2 herestring nesting bug where grep <<< "$x" inside a
            # while read <<< "$y" loop terminates the outer loop after iter 1.
            local -A aliased_set=()
            local atarget
            while IFS= read -r atarget; do
                [[ -n "$atarget" ]] && aliased_set["$atarget"]=1
            done < <(find "$LLAMACPP_MODELS_DIR" -maxdepth 2 -name "*.gguf" -type l 2>/dev/null \
                     | xargs -r readlink -f)
            local f target
            while IFS= read -r f; do
                target=$(readlink -f "$f")
                [[ -v aliased_set["$target"] ]] && continue
                printf 'cache\t%s\t%s\t%s\t\n' "${f##*/}" "$(stat -L -c %s "$f" 2>/dev/null)" "$f"
            done < <(find "$hf_cache" -name "*.gguf" 2>/dev/null)
        fi
    )

    [[ -z "$stream" ]] && {
        printf 'No GGUFs found in %s or huggingface cache\n' "$LLAMACPP_MODELS_DIR" >&2
        return 1
    }
    found=1

    case "$mode" in
        raw)
            printf '%s\n' "$stream"
            return 0 ;;
        paths)
            printf '%s\n' "$stream" | awk -F'\t' '{ print $4 }' | sort -u
            return 0 ;;
    esac

    printf '%s\n' "$stream" | awk -F'\t' -v models_dir="$LLAMACPP_MODELS_DIR" '
        function human(b,    u, i) {
            u = "BKMGT"; i = 1
            while (b >= 1024 && i < length(u)) { b /= 1024; i++ }
            return sprintf("%.1f%s", b, substr(u, i, 1))
        }
        function basename_of(name,    n, q) {
            n = name
            sub(/\.gguf$/, "", n)
            # strip a trailing quant token: -Q4_K_M, -IQ4_XS, -BF16, -F16, -Q8_0, .Q4_K_M, etc.
            if (match(n, /[-.](Q[0-9]+(_[0-9A-Z]+)*|IQ[0-9]+(_[0-9A-Z]+)*|BF16|F16|F32|MXFP4(_[A-Z]+)?|NVFP4)$/)) {
                n = substr(n, 1, RSTART - 1)
            }
            return n
        }
        function quant_of(name,    n) {
            n = name; sub(/\.gguf$/, "", n)
            if (match(n, /[-.](Q[0-9]+(_[0-9A-Z]+)*|IQ[0-9]+(_[0-9A-Z]+)*|BF16|F16|F32|MXFP4(_[A-Z]+)?|NVFP4)$/)) {
                return substr(n, RSTART + 1)
            }
            return "(unknown)"
        }
        function quant_rank(q) {
            if (q ~ /^F32/)  return 1
            if (q ~ /^F16/)  return 2
            if (q ~ /^BF16/) return 3
            if (q ~ /^Q8/)   return 4
            if (q ~ /^Q6/)   return 5
            if (q ~ /^Q5/)   return 6
            if (q ~ /^Q4/)   return 7
            if (q ~ /^IQ4/)  return 8
            if (q ~ /^Q3/)   return 9
            if (q ~ /^IQ3/)  return 10
            if (q ~ /^Q2/)   return 11
            if (q ~ /^IQ2/)  return 12
            if (q ~ /^MXFP4/) return 13
            if (q ~ /^NVFP4/) return 14
            return 99
        }
        {
            loc = $1; name = $2; size = $3; path = $4; link = $5
            base = basename_of(name)
            quant = quant_of(name)
            key = loc "\t" base
            n = ++count[key]
            rows[key, n] = quant "\t" human(size + 0) "\t" name "\t" path "\t" link
            ranks[key, n] = quant_rank(quant) "\t" quant
            seen[key] = 1
        }
        END {
            order["models"] = 1; order["cache"] = 2
            label["models"] = models_dir
            label["cache"] = "huggingface cache"
            for (k in seen) {
                split(k, p, "\t")
                # primary sort: location (models before cache); secondary: basename
                pri = (p[1] == "models") ? "1" : "2"
                ord_keys[pri "\t" sprintf("%-100s", p[2]) "\t" k] = k
            }
            n = asorti(ord_keys, sk)
            cur_loc = ""
            for (i = 1; i <= n; i++) {
                k = ord_keys[sk[i]]
                split(k, p, "\t"); loc = p[1]; base = p[2]
                if (loc != cur_loc) {
                    printf "\n  [%s]\n", label[loc]; cur_loc = loc
                }
                printf "  %s\n", base
                # sort this group by quant_rank
                m = count[k]
                for (j = 1; j <= m; j++) idx[j] = j
                for (a = 1; a < m; a++) for (b = a + 1; b <= m; b++) {
                    split(ranks[k, idx[a]], ra, "\t"); split(ranks[k, idx[b]], rb, "\t")
                    if ((ra[1] + 0) > (rb[1] + 0) || ((ra[1] + 0) == (rb[1] + 0) && ra[2] > rb[2])) {
                        t = idx[a]; idx[a] = idx[b]; idx[b] = t
                    }
                }
                for (j = 1; j <= m; j++) {
                    split(rows[k, idx[j]], r, "\t")
                    if (r[5] != "")
                        printf "      %-14s %-10s %s → %s\n", r[1], r[2], r[3], r[5]
                    else
                        printf "      %-14s %-10s %s\n", r[1], r[2], r[3]
                }
                delete idx
            }
        }
    '
}

llama-alias() {
    # llama-alias <name>                    — remove alias
    # llama-alias <name> <path>             — alias to explicit path
    # llama-alias <name> <substring>        — fuzzy: pick the unique GGUF whose
    #                                         path matches all substrings (case-insensitive)
    # Examples:
    #   llama-alias coder Qwen2.5-Coder-14B-Instruct-Q5_K_M
    #   llama-alias qwen3 Qwen3.5-27B Q6_K
    if [[ $# -eq 0 ]]; then
        printf 'Usage:\n' >&2
        printf '  llama-alias <name>                  remove alias\n' >&2
        printf '  llama-alias <name> <path|gguf>      alias to explicit path\n' >&2
        printf '  llama-alias <name> <substr>...      fuzzy resolve via llama-models\n' >&2
        return 1
    fi
    local name="$1"; shift
    local link="${LLAMACPP_MODELS_DIR}/${name}.gguf"
    mkdir -p "$LLAMACPP_MODELS_DIR"

    if [[ $# -eq 0 ]]; then
        [[ -L "$link" ]] && rm "$link" && printf 'Removed alias: %s\n' "$name" && return 0
        printf 'No alias "%s" in %s\n' "$name" "$LLAMACPP_MODELS_DIR" >&2; return 1
    fi

    local target
    # If the first arg is an existing file, treat all args as a single explicit path.
    if [[ -f "$1" ]]; then
        target=$(realpath "$1" 2>/dev/null) || { printf 'Error: path not found: %s\n' "$1" >&2; return 1; }
    else
        # Fuzzy: every arg must appear (case-insensitive) in the candidate path.
        local -a candidates=()
        local p
        while IFS= read -r p; do candidates+=("$p"); done < <(llama-models --paths 2>/dev/null)
        if (( ${#candidates[@]} == 0 )); then
            printf 'Error: no GGUFs found via llama-models --paths\n' >&2; return 1
        fi
        local arg matched=()
        for p in "${candidates[@]}"; do
            local ok=1
            for arg in "$@"; do
                grep -qiF -- "$arg" <<< "$p" || { ok=0; break; }
            done
            (( ok )) && matched+=("$p")
        done
        case ${#matched[@]} in
            0) printf 'Error: no GGUF matches: %s\n' "$*" >&2
               printf 'Try: llama-models --paths | grep -i <substr>\n' >&2
               return 1 ;;
            1) target="${matched[0]}" ;;
            *) printf 'Error: %d GGUFs match — refine the substring(s):\n' "${#matched[@]}" >&2
               printf '  %s\n' "${matched[@]}" >&2
               return 1 ;;
        esac
    fi

    [[ -f "$target" ]] || { printf 'Error: not a file: %s\n' "$target" >&2; return 1; }
    [[ -L "$link" ]] && rm "$link"
    [[ -e "$link" ]] && { printf 'Error: %s exists and is not a symlink\n' "$link" >&2; return 1; }
    ln -s "$target" "$link"
    printf 'Alias created: %s → %s\n' "$name" "$target"
    printf 'Use with: claude-local --backend llama --model %s\n' "$name"
}

llama-rm() {
    # llama-rm <substr>...        — fuzzy match against every GGUF llama-models
    #                               can see (LLAMACPP_MODELS_DIR + HF cache)
    # llama-rm <path>             — explicit GGUF path
    #
    # Files under $LLAMACPP_MODELS_DIR are removed directly; any alias symlink
    # pointing at the deleted file is also removed.
    #
    # Files inside the HuggingFace cache cannot be removed individually — the
    # HF CLI deletes by repo+revision. We resolve the GGUF up to its
    # models--<org>--<name>/ root and dispatch to `hf cache rm model/<org>/<name>`,
    # which deletes the WHOLE repo revision (siblings included).
    if [[ $# -eq 0 ]]; then
        printf 'Usage:\n' >&2
        printf '  llama-rm <path>            remove explicit GGUF\n' >&2
        printf '  llama-rm <substr>...       fuzzy resolve via llama-models\n' >&2
        printf '\nHF cache entries are removed by whole repo revision, not single file.\n' >&2
        return 1
    fi

    local target
    if [[ $# -eq 1 && -f "$1" ]]; then
        target=$(realpath "$1" 2>/dev/null) \
            || { printf 'Error: path not found: %s\n' "$1" >&2; return 1; }
    else
        local -a candidates=()
        local p
        # Skip alias symlinks (they'll be cleaned up automatically when their
        # target is deleted) but include everything else.
        while IFS= read -r p; do
            [[ -L "$p" ]] && continue
            candidates+=("$p")
        done < <(llama-models --paths 2>/dev/null)
        if (( ${#candidates[@]} == 0 )); then
            printf 'Error: no removable GGUFs found\n' >&2
            return 1
        fi
        local arg matched=()
        for p in "${candidates[@]}"; do
            local ok=1
            for arg in "$@"; do
                grep -qiF -- "$arg" <<< "$p" || { ok=0; break; }
            done
            (( ok )) && matched+=("$p")
        done
        case ${#matched[@]} in
            0) printf 'Error: no GGUF matches: %s\n' "$*" >&2
               printf 'Try: llama-models --paths | grep -i <substr>\n' >&2
               return 1 ;;
            1) target="${matched[0]}" ;;
            *) printf 'Error: %d GGUFs match — refine the substring(s):\n' "${#matched[@]}" >&2
               printf '  %s\n' "${matched[@]}" >&2
               return 1 ;;
        esac
    fi

    [[ -f "$target" ]] || { printf 'Error: not a file: %s\n' "$target" >&2; return 1; }

    local size_h
    size_h=$(stat -L -c %s "$target" 2>/dev/null \
             | awk '{ s=$1; u="BKMGT"; i=1
                      while (s>=1024 && i<length(u)) { s/=1024; i++ }
                      printf "%.1f%s", s, substr(u,i,1) }')

    if [[ "$target" == "$LLAMACPP_MODELS_DIR"/* ]]; then
        # Find aliases (symlinks in models dir) that resolve to this target.
        local -a aliases=()
        local link link_target
        while IFS= read -r link; do
            link_target=$(readlink -f "$link" 2>/dev/null)
            [[ "$link_target" == "$target" ]] && aliases+=("$link")
        done < <(find "$LLAMACPP_MODELS_DIR" -maxdepth 2 -name "*.gguf" -type l 2>/dev/null)

        printf 'About to remove:\n'
        printf '  %s  (%s)\n' "$target" "$size_h"
        if (( ${#aliases[@]} )); then
            printf 'And %d alias symlink(s) pointing to it:\n' "${#aliases[@]}"
            printf '  %s\n' "${aliases[@]}"
        fi
        local reply
        read -r -p 'Proceed? [y/N] ' reply
        [[ "$reply" =~ ^[Yy]$ ]] || { printf 'Aborted.\n'; return 1; }

        rm -f -- "$target" || return 1
        printf 'Removed: %s\n' "$target"
        local a
        for a in "${aliases[@]}"; do
            rm -f -- "$a" && printf 'Removed alias: %s\n' "$a"
        done
        return 0
    fi

    # HuggingFace cache path — extract repo ID from .../models--<org>--<name>/...
    local hf_root="${HF_HOME:-${HOME}/.cache/huggingface}/hub"
    if [[ "$target" != "$hf_root"/* ]]; then
        printf 'Error: file is neither in %s nor in the HuggingFace cache (%s)\n' \
            "$LLAMACPP_MODELS_DIR" "$hf_root" >&2
        printf '  target: %s\n' "$target" >&2
        return 1
    fi
    _hf_check_cli || return 1

    local rel="${target#"$hf_root"/}"
    local repo_dir="${rel%%/*}"     # models--Jackrong--Qwen3.5-27B-Claude-...
    local repo_id="${repo_dir#models--}"
    if [[ "$repo_id" == "$repo_dir" ]] || [[ "$repo_id" != *--* ]]; then
        printf 'Error: cannot derive HF repo id from path: %s\n' "$target" >&2
        return 1
    fi
    repo_id="${repo_id//--/\/}"     # Jackrong/Qwen3.5-27B-Claude-...
    local repo_target="model/${repo_id}"
    local repo_full="${hf_root}/${repo_dir}"
    local repo_size_h
    repo_size_h=$(du -sh "$repo_full" 2>/dev/null | awk '{print $1}')

    printf 'File lives in HuggingFace cache:\n'
    printf '  %s  (%s)\n' "$target" "$size_h"
    printf '\nThe HF CLI cannot delete a single file — it removes a whole repo revision.\n'
    printf 'About to delete the entire cached repo:\n'
    printf '  %s  (~%s)\n' "$repo_target" "${repo_size_h:-?}"
    printf '  path: %s\n' "$repo_full"
    local reply
    read -r -p 'Proceed? [y/N] ' reply
    [[ "$reply" =~ ^[Yy]$ ]] || { printf 'Aborted.\n'; return 1; }

    hf cache rm "$repo_target" --yes
}

llama-info() {
    # Show GGUF metadata. No arg = currently loaded model (or default).
    local model_path
    if [[ $# -eq 0 ]]; then
        if curl -sf --max-time 2 "http://${LLAMACPP_HOST}:${LLAMACPP_PORT}/health" &>/dev/null; then
            local loaded
            loaded=$(curl -s "http://${LLAMACPP_HOST}:${LLAMACPP_PORT}/v1/models" \
                     | python3 -c "import sys,json; d=json.load(sys.stdin)['data']; print(d[0]['id'] if d else '')" 2>/dev/null)
            printf '=== Server: %s:%s (model: %s) ===\n' "$LLAMACPP_HOST" "$LLAMACPP_PORT" "${loaded:-unknown}"
            curl -s "http://${LLAMACPP_HOST}:${LLAMACPP_PORT}/props" \
                | python3 -m json.tool 2>/dev/null \
                || printf '(props endpoint unavailable)\n'
            printf '\n'
        fi
        model_path=$(_llama_resolve_model "") || return 1
    else
        model_path=$(_llama_resolve_model "$1") || return 1
    fi

    local gguf_py="${HOME}/llama.cpp-cuda/gguf-py"
    if [[ ! -d "$gguf_py" ]]; then
        printf 'gguf-py not found at %s\n' "$gguf_py" >&2; return 1
    fi

    printf '=== GGUF metadata: %s ===\n' "$model_path"
    PYTHONPATH="$gguf_py" python3 - "$model_path" <<'PYEOF'
import sys, collections
from pathlib import Path
from gguf.gguf_reader import GGUFReader
from gguf.constants import GGUFValueType

path = sys.argv[1]
r = GGUFReader(path)

SKIP_LARGE = {"tokenizer.ggml.tokens", "tokenizer.ggml.merges",
              "tokenizer.ggml.token_type", "tokenizer.chat_template",
              "tokenizer.ggml.scores"}

def _decode_field(fld):
    if not fld.types:
        return repr(fld.parts[fld.data[0]])
    t = fld.types[0]
    if t == GGUFValueType.STRING:
        return bytes(fld.parts[fld.data[0]]).decode("utf-8", errors="replace")
    if t == GGUFValueType.ARRAY:
        inner = fld.types[1] if len(fld.types) > 1 else None
        if inner == GGUFValueType.STRING:
            return [bytes(fld.parts[i]).decode("utf-8", errors="replace") for i in fld.data]
        raw = fld.parts[fld.data[0]]
        return raw.tolist() if hasattr(raw, "tolist") else repr(raw)
    raw = fld.parts[fld.data[0]]
    if hasattr(raw, "tolist"):
        v = raw.tolist()
        return v[0] if isinstance(v, list) and len(v) == 1 else v
    return repr(raw)

arch = ""
fields_out = {}
for key, field in r.fields.items():
    if key in SKIP_LARGE:
        continue
    try:
        val = _decode_field(field)
    except Exception:
        val = "<unreadable>"
    fields_out[key] = val
    if key == "general.architecture" and isinstance(val, str):
        arch = val

general  = {k: v for k, v in fields_out.items() if k.startswith("general.")}
arch_kv  = {k: v for k, v in fields_out.items()
            if arch and k.startswith(arch + ".") and "rope.dimension_sections" not in k}
token_kv = {k: v for k, v in fields_out.items()
            if k.startswith("tokenizer.") and k not in SKIP_LARGE}

def section(title, d):
    if not d: return
    print(f"\n  [{title}]")
    w = max(len(k) for k in d)
    for k, v in d.items():
        print(f"  {k:{w}}  {v}")

section("general", general)
section("architecture", arch_kv)
section("tokenizer", token_kv)
print(f"\n  chat_template  {'yes' if 'tokenizer.chat_template' in r.fields else 'no'}")

quant_counts = collections.Counter(t.tensor_type.name for t in r.tensors)
print(f"\n  [{len(r.tensors)} tensors]")
for qtype, count in sorted(quant_counts.items(), key=lambda x: -x[1]):
    print(f"  {count:4d}  {qtype}")
print(f"\n  file size  {Path(path).stat().st_size / 1e9:.2f} GB")
PYEOF
}

# ── HUGGINGFACE UTILITIES ─────────────────────────────────────────────────────
#
# Thin wrappers around the new `hf` CLI (huggingface_hub >= 0.34). Files land
# under $LLAMACPP_MODELS_DIR so llama-models / llama-alias / llama-info pick
# them up automatically.
#
# hf-pull   REPO [FILE...]   download a HF repo (or specific files) into models dir
# hf-search QUERY            search HF for matching repos (GGUF-filtered by default)
# hf-test   REPO [FILE]      pull → alias → start ikllama → smoke-test → stop

hf-pull() {
    if [[ $# -eq 0 ]]; then
        printf 'Usage: hf-pull <repo> [file ...]\n' >&2
        printf '  repo        e.g. bartowski/Qwen2.5-Coder-7B-Instruct-GGUF\n' >&2
        printf '  file(s)     specific file(s) within the repo (optional)\n' >&2
        return 1
    fi
    _hf_check_cli || return 1

    local repo="$1"; shift
    local -a files=("$@")
    mkdir -p "$LLAMACPP_MODELS_DIR"

    local target
    if (( ${#files[@]} == 1 )) && [[ "${files[0]}" == *.gguf ]]; then
        # Single GGUF → land it directly in models dir, flat.
        target="$LLAMACPP_MODELS_DIR"
        printf 'Pulling %s :: %s → %s\n' "$repo" "${files[0]}" "$target"
        hf download "$repo" "${files[0]}" --local-dir "$target" || return 1
        printf '\nDone. Try: llama-models | grep %s\n' "${files[0]##*/}"
    else
        # Full repo or multi-file → subdir keyed on repo basename.
        target="$LLAMACPP_MODELS_DIR/${repo##*/}"
        printf 'Pulling %s → %s\n' "$repo" "$target"
        if (( ${#files[@]} )); then
            hf download "$repo" "${files[@]}" --local-dir "$target" || return 1
        else
            hf download "$repo" --local-dir "$target" || return 1
        fi
        printf '\nDone. Contents:\n'
        find "$target" -maxdepth 2 -type f -printf '  %s\t%p\n' 2>/dev/null \
            | awk '{ printf "  %10.2f MB  %s\n", $1/1048576, $2 }' \
            | sort -k3
    fi
}

hf-search() {
    if [[ $# -eq 0 ]]; then
        printf 'Usage: hf-search <query> [--all] [--author NAME] [--limit N] [--raw]\n' >&2
        printf '  default filters to GGUF repos; --all removes the filter\n' >&2
        printf '  --raw forwards to `hf models ls` unchanged\n' >&2
        return 1
    fi
    _hf_check_cli || return 1

    local all=0 raw=0 author="" limit=25
    local -a query=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all)    all=1; shift ;;
            --raw)    raw=1; shift ;;
            --author) author="$2"; shift 2 ;;
            --limit)  limit="$2"; shift 2 ;;
            *)        query+=("$1"); shift ;;
        esac
    done

    local -a args=(--search "${query[*]}" --sort downloads --limit "$limit")
    [[ -n "$author" ]] && args+=(--author "$author")
    (( all )) || args+=(--filter gguf)

    if (( raw )); then
        hf models ls "${args[@]}"
        return
    fi

    hf models ls "${args[@]}" --format json | python3 -c '
import json, sys
rows = json.load(sys.stdin)
if not rows:
    print("(no results)"); sys.exit(0)
SKIP = {"endpoints_compatible", "conversational", "region:us", "text-generation"}
def short_tags(tags, n=4):
    keep = [t for t in tags
            if t not in SKIP
            and not t.startswith("base_model:")
            and not t.startswith("dataset:")
            and not t.startswith("license:")]
    return ", ".join(keep[:n])
def short_date(s):
    return (s or "")[:10]
w = max(len(r["id"]) for r in rows)
fmt = "{:<" + str(w) + "}  {:<10}  {:>8}  {:>5}  {}"
print(fmt.format("ID", "CREATED", "DL", "LIKES", "TAGS"))
print(fmt.format("-"*w, "-"*10, "-"*8, "-"*5, "-"*40))
for r in rows:
    print(fmt.format(r["id"], short_date(r.get("created_at", "")),
                     r.get("downloads", 0), r.get("likes", 0),
                     short_tags(r.get("tags", []))))
'
}

hf-files() {
    # List files in a HF model repo (recursive, human sizes), GGUFs first.
    if [[ $# -eq 0 ]]; then
        printf 'Usage: hf-files <repo> [--all]\n' >&2
        printf '  default shows GGUFs first; --all keeps the original order\n' >&2
        return 1
    fi
    _hf_check_cli || return 1

    local all=0
    local -a args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all) all=1; shift ;;
            *)     args+=("$1"); shift ;;
        esac
    done
    local repo="${args[0]}"
    if [[ -z "$repo" ]]; then
        printf 'Error: missing repo id\n' >&2; return 1
    fi

    local raw
    if ! raw=$(hf models ls -R -h "$repo" 2>&1); then
        printf '%s\n' "$raw" >&2; return 1
    fi

    if (( all )); then
        printf '%s\n' "$raw"
    else
        # Stable partition: GGUFs first (in their original order), then the rest.
        printf '%s\n' "$raw" | awk '
            /\.gguf[[:space:]]*$/ { ggufs[++ng] = $0; next }
                                  { other[++no] = $0 }
            END {
                for (i = 1; i <= ng; i++) print ggufs[i]
                if (ng && no) print ""
                for (i = 1; i <= no; i++) print other[i]
            }
        '
    fi
}

hf-pick() {
    # Interactive: list GGUFs in <repo>, pick one, pull it via hf-pull.
    # Useful follow-up to hf-search: pick the file you want from a repo
    # without retyping its name.
    if [[ $# -eq 0 ]]; then
        printf 'Usage: hf-pick <repo>\n' >&2
        printf '  Lists GGUFs in the repo, prompts for one, then runs hf-pull.\n' >&2
        return 1
    fi
    _hf_check_cli || return 1

    local repo="$1"
    local raw
    if ! raw=$(hf models ls -R "$repo" 2>&1); then
        printf '%s\n' "$raw" >&2; return 1
    fi

    # `hf models ls -R` (no -h) emits whitespace-aligned columns:
    #     size_bytes  YYYY-MM-DD HH:MM:SS  path
    # The timestamp itself contains a space, so split into [size, path]
    # via "first whitespace token" + "last whitespace token".
    local -a paths=() sizes=()
    local line size path
    while IFS= read -r line; do
        [[ "$line" == *.gguf ]] || continue
        size=$(awk '{print $1}'  <<< "$line")
        path=$(awk '{print $NF}' <<< "$line")
        [[ -z "$path" || -z "$size" ]] && continue
        paths+=("$path")
        sizes+=("$size")
    done <<< "$raw"

    if (( ${#paths[@]} == 0 )); then
        printf 'No GGUF files found in %s\n' "$repo" >&2
        printf 'Try: hf-files %s\n' "$repo" >&2
        return 1
    fi

    if [[ ! -t 0 || ! -t 1 ]]; then
        printf 'Error: hf-pick requires an interactive terminal\n' >&2
        printf 'Use: hf-pull %s <file.gguf>\n' "$repo" >&2
        return 1
    fi

    printf 'GGUFs in %s:\n' "$repo" >&2
    local i=1 size_h
    for i in "${!paths[@]}"; do
        size_h=$(printf '%s' "${sizes[i]}" \
                 | awk '{ s=$1; u="BKMGT"; n=1
                          while (s>=1024 && n<length(u)) { s/=1024; n++ }
                          printf "%.1f%s", s, substr(u,n,1) }')
        printf '  %2d) %-9s %s\n' "$((i+1))" "$size_h" "${paths[i]}" >&2
    done

    local reply
    while :; do
        read -r -p "Pick a number 1-${#paths[@]} (q to abort): " reply
        [[ "$reply" =~ ^[Qq]$|^$ ]] && { printf 'Aborted.\n' >&2; return 1; }
        if [[ "$reply" =~ ^[0-9]+$ ]] && (( reply >= 1 && reply <= ${#paths[@]} )); then
            local picked="${paths[reply-1]}"
            printf '\nPulling: %s :: %s\n' "$repo" "$picked"
            hf-pull "$repo" "$picked"
            return $?
        fi
        printf '  Invalid choice. Enter 1-%d or q.\n' "${#paths[@]}" >&2
    done
}

hf-test() {
    # hf-test <repo> [file] — pull (if missing), alias as the repo basename,
    # start ik_llama-server, send a 1-token smoke prompt, then stop the server.
    if [[ $# -eq 0 ]]; then
        printf 'Usage: hf-test <repo> [file.gguf]\n' >&2; return 1
    fi
    _hf_check_cli || return 1

    local repo="$1" file="${2:-}"
    local alias_name="${repo##*/}"
    alias_name="${alias_name%-GGUF}"
    alias_name="${alias_name%.gguf}"

    local target_path
    if [[ -n "$file" ]]; then
        target_path="${LLAMACPP_MODELS_DIR}/${file##*/}"
        if [[ ! -f "$target_path" ]]; then
            hf-pull "$repo" "$file" || return 1
        fi
    else
        target_path="${LLAMACPP_MODELS_DIR}/${repo##*/}"
        if [[ ! -d "$target_path" ]]; then
            hf-pull "$repo" || return 1
        fi
        # If it's a single-GGUF dir, alias the file; otherwise just leave it.
        local gguf
        gguf=$(find "$target_path" -maxdepth 1 -name '*.gguf' 2>/dev/null | head -1)
        if [[ -n "$gguf" ]]; then
            target_path="$gguf"
        else
            printf 'No GGUF in %s — cannot smoke-test (safetensors needs conversion)\n' "$target_path" >&2
            return 1
        fi
    fi

    llama-alias "$alias_name" "$target_path" || return 1
    llm-local-server start --backend ikllama --model "$alias_name" || return 1

    printf '\n=== Smoke test ===\n'
    local resp
    resp=$(curl -sf --max-time 30 "http://${IKLLAMA_HOST}:${IKLLAMA_PORT}/v1/chat/completions" \
        -H 'Content-Type: application/json' \
        -d '{"model":"ikllama","messages":[{"role":"user","content":"Reply with the single word: OK"}],"max_tokens":8}' \
        | python3 -c 'import sys,json; print(json.load(sys.stdin)["choices"][0]["message"]["content"].strip())' 2>/dev/null)

    if [[ -n "$resp" ]]; then
        printf 'Model responded: %s\n' "$resp"
    else
        printf 'No response (check /tmp/ikllama-server.log)\n' >&2
    fi

    llm-local-server stop --backend ikllama
}

_hf_check_cli() {
    if ! command -v hf &>/dev/null; then
        printf 'Error: `hf` CLI not found.\n' >&2
        printf 'Install with: pip install -U "huggingface_hub[hf_xet]"\n' >&2
        return 1
    fi
    # Auto-login if no cached token. Order: HF_TOKEN env, ~/.huggingface-token, fail.
    if ! hf auth whoami &>/dev/null; then
        local key="${HF_TOKEN:-${HUGGING_FACE_HUB_TOKEN:-}}"
        [[ -z "$key" && -r "$HOME/.huggingface-token" ]] && key=$(<"$HOME/.huggingface-token")
        if [[ -z "$key" ]]; then
            printf 'Error: not logged in to HuggingFace and no token available.\n' >&2
            printf 'Either: hf auth login   (interactive)\n' >&2
            printf '    or: echo "hf_..." > ~/.huggingface-token && chmod 600 ~/.huggingface-token\n' >&2
            return 1
        fi
        printf 'HuggingFace: not logged in — auto-login from token\n'
        hf auth login --token "$key" --add-to-git-credential=false &>/dev/null || {
            printf 'Error: hf auth login failed (bad token?)\n' >&2
            return 1
        }
    fi
}

