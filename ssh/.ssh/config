    User szaghi

# SpaceHPC (ESA).
#
# spacehpc.esa.int round-robins over two login nodes that serve *different*
# host keys:
#
#   212.56.14.37  ed25519  SHA256:1snQfnU2fo647U2UbR31EGoTYvjXoi+1AXOMuJo/Rqo
#   212.56.14.36  ed25519  SHA256:CBtKnikyqP9c3bI8ooEs60bsp/BRZlvfyj/S/8V1rq0
#
# Landing alternately on the two nodes is what produced the recurring
# REMOTE HOST IDENTIFICATION HAS CHANGED warning. The previous workaround was
# -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null, which silences
# the warning by disabling host-key verification entirely -- i.e. accepting
# any machine claiming to be spacehpc.esa.int, on every connection.
#
# Correct fix: pin BOTH nodes' keys in a dedicated known_hosts file. Either
# node then verifies silently, while a genuine key change is still reported.
# Regenerate that file with:
#
#   for t in spacehpc.esa.int 212.56.14.37 212.56.14.36; do \
#       ssh-keyscan -t rsa,ecdsa,ed25519 "$t"; \
#   done | awk '!seen[$0]++' > ~/.ssh/known_hosts.spacehpc
#
# known_hosts.spacehpc is deliberately NOT tracked in dotfiles: host keys are
# site state, not configuration, and pinning stale keys across machines would
# defeat the check.
#
# ICMP is filtered at this site -- ping fails while TCP/22 is fine. Not a fault.
Host spacehpc
    HostName spacehpc.esa.int
    User u10260003
    ForwardX11 yes
    # Ubuntu's OpenSSH build defaults ForwardX11Trusted to yes, so a bare -X
    # silently behaves like -Y and grants the remote app full access to the
    # local X display. Pin it off to get genuinely untrusted forwarding.
    ForwardX11Trusted no
    UserKnownHostsFile ~/.ssh/known_hosts.spacehpc
    StrictHostKeyChecking yes
