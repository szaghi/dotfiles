# claude_code.local — adam (WSL2 workstation, 2x NVIDIA RTX, 64 GB RAM)
# Sourced at the end of ~/.bash/claude_code by the base file.

CLAUDE_IAC_EMAIL="claude01@iac.cnr.it"
CLAUDE_CFD_IAC_EMAIL="s.zaghi@iac.cnr.it"

# ── GPU CONFIGURATION ─────────────────────────────────────────────────────────
# Identify GPUs with: nvidia-smi -L
export OLLAMA_GPU_UUID="GPU-63e0fc4d-bd54-cc22-532e-299518238d61"
export OLLAMA_GPU_ID="1"

# ── OLLAMA PERFORMANCE (CUDA-specific) ────────────────────────────────────────
export OLLAMA_FLASH_ATTENTION="1"       # Reduces VRAM, required for KV quant
export OLLAMA_KV_CACHE_TYPE="q8_0"      # Halves KV cache vs f16; use q4_0 for more savings

# ── MODEL DEFAULTS ────────────────────────────────────────────────────────────
# qwen3-coder-unsloth:30b-a3b-q4_K_M — MoE 30B-A3B Q4_K_M, 18.6 GB, dual GPU (94% on GPU).
#   Imported from ~/models/Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf with
#   ~/.claude/skills/delegate/ollama/Modelfile.qwen3-coder-30b-a3b (recipe inside).
#   3B active params: 3-6x faster than the dense Qwen3.8-27B, at the same pass rate on easy tasks only;
#   on the hard bench tasks it passed 2/9 against 9/9, so delegate defaults to Qwen3.8-27B
#   (docs/claude/executor-benchmarks.md). This model stays claude-local's interactive default.
OLLAMA_DEFAULT_MODEL="qwen3-coder-unsloth:30b-a3b-q4_K_M"
# Single GPU (frees GPU 2 for HPC jobs): claude-local --model deepseek-coder-v2:16b --gpus 1
# The delegate executor is not set here: delegate defaults to ollama/qwen3.8-unsloth:27b-ud-q4_K_XL
# (override with $DELEGATE_MODEL).

# ── LLAMA.CPP ─────────────────────────────────────────────────────────────────
# Prefer the locally CUDA-built binary over any system install: llama.cpp master in
# ~/llama.cpp-master (gcc-14 + CUDA 13.1, sm_89), which replaced the b8645 build in
# ~/llama.cpp-cuda on 2026-11-26 (same speed on Qwen3-Coder, and it runs Inkling 2).
# Rebuild: git -C ~/llama.cpp-master pull --depth 1 && cmake --build ~/llama.cpp-master/build -j 12
_adam_cuda_build="${HOME}/llama.cpp-master/build/bin/llama-server"
[[ -x "$_adam_cuda_build" ]] && LLAMACPP_BIN="$_adam_cuda_build"
unset _adam_cuda_build

# Runtime libs for the CUDA-built binary (NVHPC 26.1 / CUDA 13.1)
_adam_cuda_libs="/opt/nvidia/hpc_sdk/Linux_x86_64/26.1/cuda/13.1/targets/x86_64-linux/lib:/opt/nvidia/hpc_sdk/Linux_x86_64/26.1/math_libs/13.1/targets/x86_64-linux/lib"
[[ ":${LD_LIBRARY_PATH}:" != *":${_adam_cuda_libs%%:*}:"* ]] && \
    export LD_LIBRARY_PATH="${_adam_cuda_libs}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
unset _adam_cuda_libs

# Default model: Qwen3-Coder-30B-A3B Q4_K_M (18.6 GB, all 49 layers on the two GPUs at
# --ctx 32k). The same file backs the Ollama default and ik_llama, so the engines are
# comparable. The former default (Qwen3.5-27B distilled Q6_K) is no longer on disk.
LLAMACPP_DEFAULT_MODEL="${LLAMACPP_DEFAULT_MODEL:-${HOME}/models/Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf}"

# Context: 32k, the window pi (delegate) uses. With this model on 2 x 12 GB the KV cache decides how many MoE
# experts llama.cpp's fitter moves to system RAM (measured 2026-11-26, master 09c1410, Qwen3-Coder Q4_K_M):
#   32k: 1.1 GiB weights on CPU, 9 splits, 60.5 tok/s   64k: 4.1 GiB, 27 splits, 56.3 tok/s
#   131k (the base default): 10.2 GiB, 67 splits, 27.4 tok/s
# claude-local needs more room for Claude Code's own prompt: `claude-local --backend llama --ctx 64k` costs ~7%.
LLAMACPP_CTX=32768

# ── IK_LLAMA.CPP ──────────────────────────────────────────────────────────────
# Fork of llama.cpp with aggressive CPU/hybrid optimizations and new quant
# types (IQ4_KS, IQ2_KS). Build with:
#   cmake -B build -DGGML_CUDA=ON && cmake --build build --config Release -j
_adam_ikllama_build="${HOME}/ik_llama.cpp/build/bin/llama-server"
[[ -x "$_adam_ikllama_build" ]] && IKLLAMA_BIN="$_adam_ikllama_build"
unset _adam_ikllama_build

# Qwen3-Coder-30B-A3B Q4_K_M: MoE, ik_llama's strong case; 49/49 layers on the two
# GPUs at 32k context, the fastest delegate engine in the 2026-11-26 benchmark.
# Avoid Qwen3.5 hybrid SSM models — their Mamba layers have no CUDA kernel in
# ik_llama.cpp and silently fall back to CPU. (The former default, Qwen2.5-Coder-14B
# Q5_K_M, is no longer on disk.)
IKLLAMA_MODELS_DIR="${HOME}/models"
IKLLAMA_DEFAULT_MODEL="${HOME}/models/Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf"
IKLLAMA_CTX=32768
CLAUDE_CFD_CNR_EMAIL="stefano.zaghi@cnr.it"
CLAUDE_SOMA_EMAIL="stefano.zaghi@somatwin.com"
