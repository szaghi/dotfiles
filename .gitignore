vim/.vim/autoload/plug.vim.old
vim/.vim/plugged/
vim/.vim/.netrwhist
vim/.vim/view/
vim/view/
vim/.vim/undo/
vim/vim
bash/.bash/private

# perplexity-search is a class-A skill (sources tracked here) whose class-C
# manifest entry builds a .venv *inside* the skill directory — so the venv
# lands in this repo by design. python's own venv writes a `.gitignore` with
# `*` inside it, which already hides it from status; declaring it here makes
# that explicit rather than accidental, and covers any future skill built the
# same way.
claude/.claude/skills/*/.venv/
claude/.claude/.credentials.json
claude/.claude/.env
scripts/.bin/hpc-login-venv
scripts/.config/systemd/user/*.target.wants/
*.gpg
*token*
*secret*
*api-key*
*api_key*
openrouter-ai-key

# Noctalia-generated theme files — rendered from the active palette on every
# `templates-apply`. Tracking them would put churn in git and, worse, a stow
# symlink would make Noctalia write its output straight into the repo.
desktop/.config/sway/noctalia
desktop/.config/foot/themes/
desktop/.config/alacritty/themes/
desktop/.config/gtk-3.0/noctalia.css
desktop/.config/gtk-4.0/noctalia.css
desktop/.config/qt6ct/colors/
desktop/.config/btop/themes/
desktop/.config/starship.toml

